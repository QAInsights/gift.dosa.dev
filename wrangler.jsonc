{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "gift-cabinet",
  "compatibility_date": "2026-10-30",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "gift-cabinet",
      "database_id": "bd736547-904a-484d-959d-8168a205b54e"
    }
  ],
  "send_email": [{ "name": "EMAIL" }],
  // Reminder nudges (Phase 6): set the trigger secret with:
  //   npx wrangler secret put CRON_SECRET
  // then POST https://gift.dosa.dev/api/cron/nudges daily from any scheduler
  // (GitHub Actions schedule, cron-job.org, ...) with header:
  //   Authorization: Bearer <CRON_SECRET>
  // AI capture (Phase 4): fill META_AI_ENDPOINT + META_AI_MODEL, then set the key with:
  //   npx wrangler secret put META_AI_API_KEY
  "vars": { "OTP_FROM": "cabinet@gift.dosa.dev", "META_AI_ENDPOINT": "https://api.meta.ai/v1", "META_AI_MODEL": "muse-spark-1.1", "WHATSAPP_PHONE_ID": "100289156039369", "WHATSAPP_DISPLAY_NUMBER": "+1 (555) 051-2386" },
  "observability": {
    "enabled": true,
    "traces": { "enabled": true }
  }
}
