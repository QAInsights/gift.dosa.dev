---
import "../styles/global.css";
import AmountToggle from "../components/AmountToggle.astro";
import Head from "../components/Head.astro";

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = "Gift Cabinet reads, files, and reminds about every gift card you own.",
} = Astro.props;
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <Head title={title} description={description} />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="container site-header-in">
        <a class="brand" href="/" aria-label="Gift Cabinet home">
          <svg class="logo-mark" viewBox="0 0 32 32" aria-hidden="true">
            <rect x="1" y="4" width="30" height="24" rx="3" fill="none" stroke="currentColor" stroke-width="2" />
            <path d="M6 11h20M6 16h14" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" />
            <circle cx="23" cy="22" r="4" fill="var(--color-gold)" stroke="currentColor" stroke-width="1.5" />
          </svg>
          Gift Cabinet
        </a>
        <nav class="site-nav" aria-label="Account">
          <AmountToggle />
          <a class="keep" href="/signin">Sign in</a>
          <a class="btn btn--primary btn--small" href="/signup">Start your cabinet</a>
        </nav>
      </div>
    </header>
    <main id="main">
      <div class="container">
        <slot />
      </div>
    </main>
    <footer class="site-footer">
      <div class="container site-footer-in">
        <span>Gift Cabinet — every card, filed.</span>
        <nav aria-label="Footer">
          <a href="/">Home</a>
          <a href="/signin">Sign in</a>
        </nav>
      </div>
    </footer>
  </body>
</html>
