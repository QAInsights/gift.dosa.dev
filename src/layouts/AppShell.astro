---
import { env } from "cloudflare:workers";
import "../styles/global.css";
import AmountToggle from "../components/AmountToggle.astro";
import Head from "../components/Head.astro";
import { readSessionCookie } from "../lib/auth";
import { sessionUser } from "../lib/otp";

interface Props {
  title: string;
  active: "cabinet" | "file" | "account" | "notes";
  description?: string;
}

const { title, active, description = "Your gift card cabinet." } = Astro.props;

function tab(name: Props["active"]): string {
  return active === name ? "tab is-active" : "tab";
}

const user = env.DB ? await sessionUser(env.DB, readSessionCookie(Astro.request.headers.get("cookie"))).catch(() => null) : null;
const displayName = user?.name?.trim() ?? "";
let initials = "";
if (user?.name?.trim()) {
  const words = user.name.trim().split(/\s+/);
  initials = (words[0][0] + (words.length > 1 ? words[words.length - 1][0] : "")).toUpperCase();
} else if (user?.email) {
  initials = user.email[0].toUpperCase();
}
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <Head title={title} description={description} />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="topbar">
      <div class="container topbar-in">
        <a class="brand" href="/cabinet" aria-label="Gift Cabinet">
          <svg class="logo-mark" viewBox="0 0 32 32" aria-hidden="true">
            <rect x="1" y="4" width="30" height="24" rx="3" fill="none" stroke="currentColor" stroke-width="2" />
            <path d="M6 11h20M6 16h14" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" />
            <circle cx="23" cy="22" r="4" fill="var(--color-lime)" stroke="currentColor" stroke-width="1.5" />
          </svg>
          <span>Gift Cabinet</span>
        </a>
        <nav class="tabs" aria-label="Screens">
          <a class={tab("cabinet")} href="/cabinet" aria-current={active === "cabinet" ? "page" : undefined}>
            <svg class="ic" aria-hidden="true"><use href="#i-grid" /></svg>Cabinet
          </a>
          <a class={tab("notes")} href="/notes" aria-current={active === "notes" ? "page" : undefined}>
            <svg class="ic" aria-hidden="true"><use href="#i-note" /></svg>Notes
          </a>
          <a class="tab tab--action" href="/file">
            <svg class="ic" aria-hidden="true"><use href="#i-plus" /></svg>File a card
          </a>
        </nav>
        <div class="topbar-actions">
          <AmountToggle />
          {user && (
            <a class="profile-chip" href="/account" aria-label={displayName ? `Account: ${displayName}` : "Your account"} aria-current={active === "account" ? "page" : undefined}>
              <span class="avatar" aria-hidden="true">{initials}</span>
              {displayName && <span class="profile-name">{displayName}</span>}
            </a>
          )}
        </div>
      </div>
    </header>
    <main id="main" class="screen">
      <div class="container">
        <slot />
      </div>
    </main>
    <footer class="site-footer">
      <div class="container site-footer-in">
        <span>Gift Cabinet — every card, filed.</span>
      </div>
    </footer>
  </body>
</html>
