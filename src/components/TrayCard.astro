---
import type { PublicCard } from "../lib/cards";
import { formatDate, formatMoney, type DateFormat } from "../lib/format";
import StatePill from "./StatePill.astro";
import StoreMark from "./StoreMark.astro";

interface Props {
  card: PublicCard;
  index: number;
  dateFormat?: DateFormat;
}

const { card, index, dateFormat = "MDY" } = Astro.props;
const tilt = index % 2 === 0 ? "-1.1deg" : "0.9deg";
const foot = card.nickname ?? card.occasion ?? "";
---

<a class="gcard" href={`/cards/${card.id}`} style={`--i:${index}; --tilt:${tilt}`}>
  <span class="gcard-enter">
    <span class="gface">
      <span class="gcard-top">
        <StoreMark retailer={card.retailer} />
        <span class="gname">{card.retailer}</span>
        <StatePill state={card.state} />
      </span>
      <span class="gbalance mono" data-amount>{formatMoney(card.balance_cents, card.currency)}</span>
      <span class="gfoot mono">
        <span>{card.expiry ? `Exp ${formatDate(card.expiry, dateFormat)}` : "No expiry"}</span>
        <span class="gfoot-meta">
          {foot && <span>{foot}</span>}
          {card.sample && <span class="tag">Sample</span>}
        </span>
      </span>
    </span>
  </span>
</a>
