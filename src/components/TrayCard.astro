---
import type { PublicCard } from "../lib/cards";
import { formatDate, formatMoney, type DateFormat } from "../lib/format";

interface Props {
  card: PublicCard;
  index: number;
  dateFormat?: DateFormat;
}

const { card, index, dateFormat = "MDY" } = Astro.props;
const variant = ["target", "books", "coffee"][index % 3];
const eyebrow = (card.nickname ?? card.occasion ?? "Gift card").toUpperCase();
const amount = formatMoney(card.balance_cents, card.currency);
const dot = amount.lastIndexOf(".");
const major = dot > 0 ? amount.slice(0, dot) : amount;
const minor = dot > 0 ? amount.slice(dot) : "";
---

<a class={`gift ${variant}`} href={`/cards/${card.id}`}>
  <span class="tiny">{eyebrow}</span>
  <span class="card-name">{card.retailer}</span>
  <strong data-amount>{major}{minor && <span class="cents">{minor}</span>}</strong>
  <span class="tiny">{card.expiry ? `EXP ${formatDate(card.expiry, dateFormat).toUpperCase()}` : "NO EXPIRY ON FILE"}</span>
</a>
