---
/* Ask the shelf: questions and errand plans in one panel, tabbed. */
---
<section class="panel ask-panel" aria-labelledby="ask-title">
  <div class="ask-head">
    <h2 id="ask-title">Ask</h2>
    <p class="sub">Plain words in, shelf answers out. Every answer names its cards.</p>
  </div>
  <div class="ask-tabs" role="tablist" aria-label="Ask or plan">
    <button class="ask-tab" type="button" role="tab" id="tab-ask" aria-controls="tabpanel-ask" aria-selected="true">Ask</button>
    <button class="ask-tab" type="button" role="tab" id="tab-plan" aria-controls="tabpanel-plan" aria-selected="false" tabindex="-1">Plan</button>
  </div>
  <div id="tabpanel-ask" role="tabpanel" aria-labelledby="tab-ask">
    <form id="ask-form" class="ask-form">
      <label class="visually-hidden" for="ask-q">Ask the cabinet</label>
      <input class="input" id="ask-q" name="question" type="text" autocomplete="off" maxlength="300" placeholder="What expires first?" />
      <button class="btn btn--primary" type="submit">
        <svg class="ic ic--sm" aria-hidden="true"><use href="#i-send" /></svg>Ask
      </button>
    </form>
    <div class="chips" aria-label="Sample questions">
      <button class="btn btn--small" type="button" data-q="What expires first?">What expires first?</button>
      <button class="btn btn--small" type="button" data-q="What should I spend first?">What should I spend first?</button>
      <button class="btn btn--small" type="button" data-q="How much do I have?">How much do I have?</button>
    </div>
    <p class="help" id="ask-help" aria-live="polite"></p>
  </div>
  <div id="tabpanel-plan" role="tabpanel" aria-labelledby="tab-plan" hidden>
    <form id="plan-form" class="ask-form">
      <label class="visually-hidden" for="plan-q">List your errands</label>
      <input class="input" id="plan-q" name="errands" type="text" autocomplete="off" maxlength="300" placeholder="Groceries, a birthday gift, coffee…" />
      <button class="btn btn--primary" type="submit">
        <svg class="ic ic--sm" aria-hidden="true"><use href="#i-send" /></svg>Plan
      </button>
    </form>
    <div class="chips" aria-label="Sample errand lists">
      <button class="btn btn--small" type="button" data-errands="groceries, coffee">Groceries, coffee</button>
    </div>
    <p class="help" id="plan-help" aria-live="polite"></p>
  </div>
  <p class="state-label" id="ask-empty">Nothing asked yet. Pick a question or list some errands.</p>
  <div class="thread" id="ask-thread" aria-live="polite"></div>
</section>

<script>
  const tabs = [...document.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
  function selectTab(next: HTMLButtonElement, focus = false): void {
    for (const tab of tabs) {
      const on = tab === next;
      tab.setAttribute("aria-selected", String(on));
      tab.tabIndex = on ? 0 : -1;
      document.getElementById(tab.getAttribute("aria-controls") ?? "")?.toggleAttribute("hidden", !on);
      if (on && focus) tab.focus();
    }
  }
  for (const tab of tabs) {
    tab.addEventListener("click", () => selectTab(tab));
    tab.addEventListener("keydown", (event) => {
      if (event.key !== "ArrowRight" && event.key !== "ArrowLeft") return;
      event.preventDefault();
      const i = tabs.indexOf(tab);
      const next = tabs[(i + (event.key === "ArrowRight" ? 1 : tabs.length - 1)) % tabs.length];
      selectTab(next, true);
    });
  }
</script>

<script>
  type AskCitation = { id: string; retailer: string };
  const askForm = document.getElementById("ask-form") as HTMLFormElement | null;
  const askInput = document.getElementById("ask-q") as HTMLInputElement | null;
  const askThread = document.getElementById("ask-thread");
  const askEmpty = document.getElementById("ask-empty");
  const askHelp = document.getElementById("ask-help");
  const askReduceMotion = matchMedia("(prefers-reduced-motion: reduce)").matches;

  function addBubble(text: string, mine: boolean): HTMLDivElement {
    const wrap = document.createElement("div");
    wrap.className = (mine ? "bubble bubble--you" : "bubble bubble--cab") + " enter";
    const p = document.createElement("p");
    p.textContent = text;
    wrap.appendChild(p);
    askThread?.appendChild(wrap);
    if (askEmpty) askEmpty.hidden = true;
    wrap.scrollIntoView({ behavior: askReduceMotion ? "auto" : "smooth", block: "nearest" });
    return wrap;
  }

  function addCitations(bubble: HTMLDivElement, citations: AskCitation[]): void {
    if (citations.length === 0) return;
    const cite = document.createElement("span");
    cite.className = "cite";
    const icon = document.createElementNS("http://www.w3.org/2000/svg", "svg");
    icon.setAttribute("class", "ic ic--sm");
    icon.setAttribute("aria-hidden", "true");
    const use = document.createElementNS("http://www.w3.org/2000/svg", "use");
    use.setAttribute("href", "#i-receipt");
    icon.appendChild(use);
    cite.appendChild(icon);
    cite.appendChild(document.createTextNode("From "));
    citations.forEach((card, i) => {
      if (i > 0) cite.appendChild(document.createTextNode(", "));
      const link = document.createElement("a");
      link.href = `/cards/${card.id}`;
      link.textContent = card.retailer;
      cite.appendChild(link);
    });
    cite.appendChild(document.createTextNode("."));
    bubble.appendChild(cite);
  }

  const askChips = document.querySelectorAll<HTMLButtonElement>("[data-q]");

  async function ask(question: string, refocus = true): Promise<void> {
    if (!askForm || !askInput || !askThread) return;
    addBubble(question, true);
    const button = askForm.querySelector<HTMLButtonElement>('button[type="submit"]');
    if (button) button.disabled = true;
    for (const chip of askChips) chip.disabled = true;
    if (askHelp) {
      askHelp.textContent = "Reading the shelf…";
      askHelp.className = "help";
    }
    try {
      const res = await fetch("/api/ask", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ question }),
      });
      const data = (await res.json().catch(() => ({}))) as { error?: string; answer?: string; citations?: AskCitation[] };
      if (!res.ok || typeof data.answer !== "string") {
        throw new Error(data.error || "The cabinet could not answer. Try again.");
      }
      addCitations(addBubble(data.answer, false), data.citations ?? []);
      if (askHelp) askHelp.textContent = "";
    } catch (error) {
      addBubble(error instanceof Error ? error.message : "The cabinet could not answer. Try again.", false);
      if (askHelp) askHelp.textContent = "";
    } finally {
      if (button) button.disabled = false;
      for (const chip of askChips) chip.disabled = false;
      if (refocus) askInput.focus();
    }
  }

  askForm?.addEventListener("submit", (event) => {
    event.preventDefault();
    const question = askInput?.value.trim() ?? "";
    if (!question) {
      askInput?.focus();
      return;
    }
    if (askInput) askInput.value = "";
    void ask(question);
  });
  for (const chip of askChips) {
    chip.addEventListener("click", () => {
      const question = chip.getAttribute("data-q");
      if (question) void ask(question, false);
    });
  }
</script>

<script>
  type PlanCard = { id: string; retailer: string; balance_cents: number; currency: string; expiry: string | null };
  type PlanLine = { errand: string; note: string; card: PlanCard | null };
  const planForm = document.getElementById("plan-form") as HTMLFormElement | null;
  const planInput = document.getElementById("plan-q") as HTMLInputElement | null;
  const planThread = document.getElementById("ask-thread");
  const planEmptyLabel = document.getElementById("ask-empty");
  const planHelp = document.getElementById("plan-help");
  const planReduceMotion = matchMedia("(prefers-reduced-motion: reduce)").matches;

  function planBubble(mine: boolean): HTMLDivElement {
    const wrap = document.createElement("div");
    wrap.className = (mine ? "bubble bubble--you" : "bubble bubble--cab") + " enter";
    planThread?.appendChild(wrap);
    if (planEmptyLabel) planEmptyLabel.hidden = true;
    wrap.scrollIntoView({ behavior: planReduceMotion ? "auto" : "smooth", block: "nearest" });
    return wrap;
  }

  function money(cents: number, currency: string): string {
    try {
      return new Intl.NumberFormat("en-US", { style: "currency", currency }).format(cents / 100);
    } catch {
      return `${(cents / 100).toFixed(2)} ${currency}`;
    }
  }

  function renderPlan(summary: string, lines: PlanLine[]): void {
    const bubble = planBubble(false);
    const lead = document.createElement("p");
    lead.className = "plan-summary";
    lead.textContent = summary;
    bubble.appendChild(lead);
    if (lines.length === 0) return;
    const list = document.createElement("ul");
    list.className = "plan-lines";
    for (const line of lines) {
      const item = document.createElement("li");
      const errand = document.createElement("strong");
      errand.textContent = line.errand;
      item.appendChild(errand);
      if (line.card) {
        item.appendChild(document.createTextNode(": "));
        const link = document.createElement("a");
        link.href = `/cards/${line.card.id}`;
        link.textContent = line.card.retailer;
        item.appendChild(link);
        item.appendChild(document.createTextNode(` ${money(line.card.balance_cents, line.card.currency)}`));
      } else {
        item.appendChild(document.createTextNode(": no live card"));
      }
      if (line.note) {
        const note = document.createElement("span");
        note.className = "plan-note";
        note.textContent = ` ${line.note}`;
        item.appendChild(note);
      }
      list.appendChild(item);
    }
    bubble.appendChild(list);
  }

  const planChips = document.querySelectorAll<HTMLButtonElement>("[data-errands]");

  async function plan(errands: string, refocus = true): Promise<void> {
    if (!planForm || !planInput || !planThread) return;
    const you = planBubble(true);
    const said = document.createElement("p");
    said.textContent = `Plan: ${errands}`;
    you.appendChild(said);
    const button = planForm.querySelector<HTMLButtonElement>('button[type="submit"]');
    if (button) button.disabled = true;
    for (const chip of planChips) chip.disabled = true;
    if (planHelp) {
      planHelp.textContent = "Matching errands to cards…";
      planHelp.className = "help";
    }
    try {
      const res = await fetch("/api/plan", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ errands }),
      });
      const data = (await res.json().catch(() => ({}))) as { error?: string; summary?: string; lines?: PlanLine[] };
      if (!res.ok || typeof data.summary !== "string" || !Array.isArray(data.lines)) {
        throw new Error(data.error || "The cabinet could not plan. Try again.");
      }
      renderPlan(data.summary, data.lines);
      if (planHelp) planHelp.textContent = "";
    } catch (error) {
      const failed = document.createElement("p");
      failed.textContent = error instanceof Error ? error.message : "The cabinet could not plan. Try again.";
      planBubble(false).appendChild(failed);
      if (planHelp) planHelp.textContent = "";
    } finally {
      if (button) button.disabled = false;
      for (const chip of planChips) chip.disabled = false;
      if (refocus) planInput.focus();
    }
  }

  planForm?.addEventListener("submit", (event) => {
    event.preventDefault();
    const errands = planInput?.value.trim() ?? "";
    if (!errands) {
      planInput?.focus();
      return;
    }
    if (planInput) planInput.value = "";
    void plan(errands);
  });
  for (const chip of planChips) {
    chip.addEventListener("click", () => {
      const errands = chip.getAttribute("data-errands");
      if (errands) void plan(errands, false);
    });
  }
</script>

<style>
  .ask-tabs { display: flex; gap: var(--space-xs); margin-bottom: var(--space-md); }
  .ask-tab {
    border: var(--rule-hair) solid var(--color-rule); border-radius: var(--radius-pill);
    background: none; color: var(--color-ink-2);
    font: inherit; font-size: var(--text-sm); font-weight: 600;
    padding: var(--space-2xs) var(--space-md); cursor: pointer;
  }
  .ask-tab[aria-selected="true"] { background: var(--color-lime-soft); color: var(--color-ink); border-color: var(--color-lime-deep); }
</style>
