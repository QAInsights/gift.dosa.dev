---
import { faviconUrl, storeDomain } from "../lib/stores";

interface Props {
  retailer: string;
}

const { retailer } = Astro.props;
const domain = storeDomain(retailer);
const initial = retailer.trim().charAt(0).toUpperCase() || "G";
---

{
  domain ? (
    <span class="store-mark" aria-hidden="true">
      <span class="store-mark-initial">{initial}</span>
      <img
        class="store-mark-img"
        src={faviconUrl(domain)}
        alt=""
        width="28"
        height="28"
        loading="lazy"
        decoding="async"
        referrerpolicy="no-referrer"
        onload="this.parentNode.classList.add('is-loaded')"
        onerror="this.remove()"
      />
    </span>
  ) : (
    <span class="monogram" aria-hidden="true">{initial}</span>
  )
}
