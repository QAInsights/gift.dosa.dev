---
import { getCollection } from "astro:content";
import LibraryArt from "../../components/LibraryArt.astro";
import MotionFigure from "../../components/illustrations/MotionFigure.astro";
import Public from "../../layouts/Public.astro";
import {
  SITE_ORIGIN,
  allTags,
  collectionJsonLd,
  formatLibraryDate,
  readingMinutes,
  type LibraryEntry,
} from "../../lib/library";

const entries = ((await getCollection("library")) as LibraryEntry[]).sort(
  (a, b) => b.data.published.getTime() - a.data.published.getTime(),
);
const guides = entries.filter((entry) => entry.data.kind === "guide");
const articles = entries.filter((entry) => entry.data.kind !== "guide");
const feature = articles[0];
const tags = allTags(entries);
---

<Public
  title="Gift Cabinet Library · Gift card help that earns its keep"
  description="Practical gift card guides: spend small balances, check balances safely, and judge deals before you buy."
  canonical={`${SITE_ORIGIN}/library`}
  ogType="website"
  jsonLd={[collectionJsonLd(entries)]}
>
  <section class="lib-hero" aria-labelledby="h1">
    <div class="lib-hero-in">
      <p class="eyebrow">Gift Cabinet · Library</p>
      <h1 id="h1">The Library.</h1>
      <p class="lib-sub">Short, practical help for spending gift cards well.</p>
      <form class="lib-search" id="lib-search" role="search">
        <label class="visually-hidden" for="lib-q">Search the library</label>
        <input
          class="input"
          id="lib-q"
          name="q"
          type="search"
          autocomplete="off"
          maxlength="80"
          placeholder="Balances, safety, deals…"
        />
      </form>
      {
        tags.length > 0 && (
          <div class="lib-tags" role="group" aria-label="Filter by topic">
            {tags.map((tag) => (
              <button class="chip lib-tag" type="button" data-tag={tag} aria-pressed="false">
                {tag}
              </button>
            ))}
          </div>
        )
      }
      <p class="lib-count" id="lib-count" aria-live="polite"></p>
    </div>
    <MotionFigure scene="home" />
  </section>

  {
    guides.length > 0 && (
      <section class="lib-section" aria-labelledby="guides">
        <h2 id="guides">Retailer guides</h2>
        <div class="lib-grid" id="lib-guides">
          {guides.map((entry) => (
            <a
              class="panel lib-card"
              href={`/library/${entry.id}`}
              data-title={entry.data.title.toLowerCase()}
              data-desc={entry.data.description.toLowerCase()}
              data-tags={entry.data.tags.join(" ").toLowerCase()}
            >
              <LibraryArt entry={entry} />
              <span class="lib-topline">
                {entry.data.retailer ?? "Guide"} · {formatLibraryDate(entry.data.published)} · {readingMinutes(entry.body)} min read
              </span>
              <span class="lib-title">{entry.data.title}</span>
              <span class="lib-desc">{entry.data.description}</span>
              <span class="lib-read">Read →</span>
            </a>
          ))}
        </div>
      </section>
    )
  }

  <section class="lib-section" aria-labelledby="articles">
    <h2 id="articles">Articles <span class="lib-h2-count">({articles.length})</span></h2>
    <div class="lib-grid" id="lib-articles">
      {
        feature && (
          <a
            class="panel lib-card lib-feature"
            href={`/library/${feature.id}`}
            data-title={feature.data.title.toLowerCase()}
            data-desc={feature.data.description.toLowerCase()}
            data-tags={feature.data.tags.join(" ").toLowerCase()}
          >
            <LibraryArt entry={feature} variant="feature" />
            <span class="lib-feature-main">
              <span class="lib-kind">Latest</span>
              <span class="lib-title lib-title--feature">{feature.data.title}</span>
              <span class="lib-desc">{feature.data.description}</span>
              <span class="lib-topline">
                {formatLibraryDate(feature.data.published)} · {readingMinutes(feature.body)} min read
              </span>
            </span>
            <span class="lib-feature-side">
              {feature.data.tags.length > 0 && (
                <span class="lib-card-tags">
                  {feature.data.tags.map((tag) => (
                    <span class="lib-card-tag">{tag}</span>
                  ))}
                </span>
              )}
              <span class="lib-read">Read the guide →</span>
            </span>
          </a>
        )
      }
      {
        articles.slice(1).map((entry) => (
          <a
            class="panel lib-card"
            href={`/library/${entry.id}`}
            data-title={entry.data.title.toLowerCase()}
            data-desc={entry.data.description.toLowerCase()}
            data-tags={entry.data.tags.join(" ").toLowerCase()}
          >
            <LibraryArt entry={entry} />
            <span class="lib-topline">
              {formatLibraryDate(entry.data.published)} · {readingMinutes(entry.body)} min read
            </span>
            <span class="lib-title">{entry.data.title}</span>
            <span class="lib-desc">{entry.data.description}</span>
            {entry.data.tags.length > 0 && (
              <span class="lib-card-tags">
                {entry.data.tags.map((tag) => (
                  <span class="lib-card-tag">{tag}</span>
                ))}
              </span>
            )}
            <span class="lib-read">Read →</span>
          </a>
        ))
      }
    </div>
    <nav class="lib-pager" id="lib-pager" aria-label="Article pages" hidden></nav>
    <p class="note" id="lib-empty" hidden>
      Nothing matches that search yet. Try a shorter word, or clear the topic filter.
    </p>
  </section>
</Public>

<script>
  const PAGE_SIZE = 9;
  const form = document.getElementById("lib-search") as HTMLFormElement | null;
  const input = document.getElementById("lib-q") as HTMLInputElement | null;
  const count = document.getElementById("lib-count");
  const empty = document.getElementById("lib-empty");
  const pager = document.getElementById("lib-pager");
  const guideCards = [...document.querySelectorAll<HTMLElement>("#lib-guides .lib-card")];
  const articleCards = [...document.querySelectorAll<HTMLElement>("#lib-articles .lib-card")];
  const chips = [...document.querySelectorAll<HTMLButtonElement>(".lib-tag")];
  const params = new URLSearchParams(location.search);
  let activeTag = (params.get("tag") ?? "").toLowerCase();
  let page = Math.max(1, Number.parseInt(params.get("page") ?? "", 10) || 1);

  function matches(card: HTMLElement, q: string): boolean {
    const hay = `${card.dataset.title ?? ""} ${card.dataset.desc ?? ""} ${card.dataset.tags ?? ""}`;
    const tagOk = !activeTag || (card.dataset.tags ?? "").split(" ").includes(activeTag);
    return (!q || hay.includes(q)) && tagOk;
  }

  function renderPager(pages: number): void {
    if (!pager) return;
    pager.hidden = pages <= 1;
    pager.replaceChildren();
    if (pages <= 1) return;
    const prev = document.createElement("button");
    prev.type = "button";
    prev.className = "chip lib-page";
    prev.textContent = "Prev";
    prev.setAttribute("aria-label", "Previous page");
    prev.disabled = page <= 1;
    prev.dataset.page = String(page - 1);
    pager.appendChild(prev);
    for (let i = 1; i <= pages; i++) {
      const btn = document.createElement("button");
      btn.type = "button";
      btn.className = "chip lib-page";
      btn.textContent = String(i);
      btn.setAttribute("aria-label", `Page ${i}`);
      btn.dataset.page = String(i);
      if (i === page) btn.setAttribute("aria-current", "page");
      pager.appendChild(btn);
    }
    const next = document.createElement("button");
    next.type = "button";
    next.className = "chip lib-page";
    next.textContent = "Next";
    next.setAttribute("aria-label", "Next page");
    next.disabled = page >= pages;
    next.dataset.page = String(page + 1);
    pager.appendChild(next);
    const status = document.createElement("span");
    status.className = "lib-page-status";
    status.textContent = `Page ${page} of ${pages}`;
    pager.appendChild(status);
  }

  function apply(resetPage: boolean): void {
    const q = (input?.value ?? "").trim().toLowerCase();
    if (resetPage) page = 1;
    const matchedGuides = guideCards.filter((card) => matches(card, q));
    const matchedArticles = articleCards.filter((card) => matches(card, q));
    const pages = Math.max(1, Math.ceil(matchedArticles.length / PAGE_SIZE));
    if (page > pages) page = pages;
    for (const card of guideCards) card.hidden = !matchedGuides.includes(card);
    const start = (page - 1) * PAGE_SIZE;
    matchedArticles.forEach((card, index) => {
      card.hidden = index < start || index >= start + PAGE_SIZE;
    });
    for (const card of articleCards) {
      if (!matchedArticles.includes(card)) card.hidden = true;
    }
    for (const chip of chips) {
      const on = (chip.dataset.tag ?? "").toLowerCase() === activeTag && activeTag !== "";
      chip.setAttribute("aria-pressed", String(on));
      chip.classList.toggle("is-active", on);
    }
    const shown = matchedGuides.length + matchedArticles.length;
    if (empty) empty.hidden = shown > 0;
    if (count) {
      count.textContent =
        q || activeTag
          ? `${shown} ${shown === 1 ? "result" : "results"}${activeTag ? ` in ${activeTag}` : ""}.`
          : "";
    }
    renderPager(pages);
    const next = new URLSearchParams();
    if (q) next.set("q", q);
    if (activeTag) next.set("tag", activeTag);
    if (page > 1) next.set("page", String(page));
    history.replaceState(null, "", `${location.pathname}${next.size ? `?${next}` : ""}`);
  }

  if (input && params.get("q")) input.value = params.get("q") ?? "";
  form?.addEventListener("submit", (event) => event.preventDefault());
  input?.addEventListener("input", () => apply(true));
  for (const chip of chips) {
    chip.addEventListener("click", () => {
      const tag = (chip.dataset.tag ?? "").toLowerCase();
      activeTag = activeTag === tag ? "" : tag;
      apply(true);
    });
  }
  pager?.addEventListener("click", (event) => {
    const target = (event.target as HTMLElement).closest("button[data-page]") as HTMLButtonElement | null;
    if (!target || target.disabled) return;
    page = Math.max(1, Number.parseInt(target.dataset.page ?? "1", 10) || 1);
    apply(false);
  });
  apply(false);
</script>

<style>
  .lib-hero {
    display: grid;
    gap: var(--space-md);
    padding-block: 0 var(--space-xl);
    align-items: center;
  }
  .lib-hero-in {
    display: grid;
    gap: var(--space-md);
  }
  .lib-hero h1 {
    font-size: clamp(34px, 4vw, 48px);
    letter-spacing: -0.04em;
    margin: 0;
    overflow-wrap: break-word;
    min-width: 0;
  }
  .lib-sub {
    font-size: var(--text-lg);
    color: var(--color-ink-2);
    margin: 0;
  }
  .lib-search .input {
    width: 100%;
  }
  .lib-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
  }
  .lib-tag {
    cursor: pointer;
    font-family: inherit;
  }
  .lib-tag[aria-pressed="true"] {
    background: var(--color-lime-soft);
    border-color: var(--color-lime-deep);
  }
  .lib-count {
    margin: 0;
    min-height: 1.5em;
    color: var(--color-ink-2);
  }
  .lib-pager {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-xs);
    margin-top: var(--space-md);
  }
  .lib-pager[hidden] {
    display: none;
  }
  .lib-page {
    min-width: 2.5rem;
  }
  .lib-page[aria-current="page"] {
    background: var(--color-lime-soft);
    border-color: var(--color-lime-deep);
  }
  .lib-pager button:disabled {
    opacity: 0.45;
    cursor: default;
  }
  .lib-page-status {
    color: var(--color-ink-2);
    font-size: var(--text-sm);
    margin-left: auto;
  }
  .lib-h2-count {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 400;
    color: var(--color-muted);
  }
  .lib-hero-in {
    max-width: 46rem;
  }
  @media (min-width: 761px) {
    .lib-hero {
      grid-template-columns: minmax(0, 1fr) minmax(0, 340px);
      gap: var(--space-2xl);
      align-items: center;
    }
  }
</style>
