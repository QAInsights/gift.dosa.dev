---
import AuthForm from "../components/AuthForm.astro";
import MotionFigure from "../components/illustrations/MotionFigure.astro";
import Base from "../layouts/Base.astro";

export const prerender = true;
---

<Base title="Gift Cabinet · Sign up">
  <div class="auth-layout">
    <MotionFigure scene="auth" />
    <div class="flow--narrow auth-col">
      <AuthForm mode="signup" />
      <p class="sub">
        Already filed? <a href="/signin">Sign in</a>
      </p>
    </div>
  </div>
</Base>
