---
import { env } from "cloudflare:workers";
import AskPanel from "../components/AskPanel.astro";
import MotionFigure from "../components/illustrations/MotionFigure.astro";
import AppShell from "../layouts/AppShell.astro";
import StatePill from "../components/StatePill.astro";
import StoreMark from "../components/StoreMark.astro";
import Base from "../layouts/Base.astro";
import { SITE_ORIGIN } from "../lib/library";
import { readSessionCookie } from "../lib/auth";
import { dashboard, recentActivity, todayYmd, type Dashboard, type PublicCard } from "../lib/cards";
import { formatDate, formatMoney, formatTotals, type DateFormat } from "../lib/format";
import { sessionContext } from "../lib/otp";
import { DEFAULT_PREFS, getPrefs } from "../lib/prefs";

let signedIn = false;
let activity: PublicCard[] = [];
let totals: Record<string, number> = {};
let dues: Record<string, number> = {};
let cardCount = 0;
let expiring: Dashboard["expiring"] = [];
let spendNext: Dashboard["spendNext"] = null;
let dateFormat: DateFormat = "MDY";
try {
  if (env.DB) {
    const ctx = await sessionContext(env.DB, readSessionCookie(Astro.request.headers.get("cookie")));
    if (ctx) {
      signedIn = true;
      const today = todayYmd();
      const [dash, recent, prefs] = await Promise.all([
        dashboard(env.DB, ctx.user.id, ctx.unlocked, today),
        recentActivity(env.DB, ctx.user.id, ctx.unlocked, today),
        getPrefs(env.DB, ctx.user.id).catch(() => ({ ...DEFAULT_PREFS })),
      ]);
      totals = dash.totals;
      dues = dash.dues;
      cardCount = dash.cardCount;
      expiring = dash.expiring;
      spendNext = dash.spendNext;
      activity = recent;
      dateFormat = prefs.dateFormat;
    }
  }
} catch {
  signedIn = false;
  activity = [];
}
const fd = (ymd: string): string => formatDate(ymd, dateFormat);
const dayOf = (ms: number): string => new Date(ms).toISOString().slice(0, 10);
---

{!signedIn && (
<Base
  title="Gift Cabinet · Good gifts deserve a better drawer"
  description="A thoughtful home for every gift card. Snap it, say it, or type it, then remember to enjoy it."
  canonical={`${SITE_ORIGIN}/`}
>
    <div class="k-page" id="k-page">
  <section class="k-hero" id="k-hero" aria-labelledby="h1" data-guide="" data-next="#ledger-wrap">
    <div class="k-intro">
      <p class="k-eyebrow">For the gifts you meant to use.</p>
      <h1 id="h1">Good gifts deserve<br />a <em>better drawer.</em></h1>
      <p class="k-sub">A thoughtful home for every gift card. Snap it, say it, or type it, then remember to enjoy it.</p>
      <p class="actions">
        <a class="btn btn--primary btn--large" href="/signup">Start your cabinet</a>
        <a class="k-textlink" href="#how">Take a little look</a>
        <button class="k-guide" id="k-guide" type="button" data-next="#ledger-wrap" aria-label="Scroll to the next part">
          <span class="k-guide-emoji" aria-hidden="true">🎁</span>
          <span class="k-guide-label" id="k-guide-label" aria-hidden="true"></span>
        </button>
      </p>
      <p class="k-fine">Photo, voice, or typing. A cabinet that feels like yours.</p>
    </div>
    <div class="k-scene" id="demo">
      <div class="k-cabinet">
        <div class="k-cabtop"><span>Your everyday cabinet</span><span class="mono">Sample</span></div>
        <div class="k-cards" aria-hidden="true">
          <div class="k-gift"><strong>Bookshop</strong><span class="k-balance">$50.00</span></div>
          <div class="k-gift"><strong>Local coffee</strong><span class="k-balance">$12.00</span></div>
          <div class="k-gift"><strong>Target</strong><span class="k-balance">$25.00</span><span class="k-small">From someone who knows you.</span></div>
        </div>
        <button class="k-drawer" id="open-drawer" type="button" aria-expanded="true" aria-controls="drawer-detail">
          <span class="k-drawer-label">The everyday drawer</span>
          <span class="k-handle" aria-hidden="true"></span>
          <small id="drawer-hint">Your illustrated drawer is open</small>
          <span id="drawer-detail">Target · Bookshop · Local coffee<br />Three little possibilities.</span>
        </button>
        <div class="k-drawer k-sealed">
          <span class="k-drawer-label">Keepsakes</span>
          <span class="k-handle" aria-hidden="true"></span>
          <small>Sealed, until you say otherwise.</small>
        </div>
      </div>
      <div class="k-note">
        <p class="k-note-eyebrow">A gentle reminder</p>
        <p>That coffee promo?<br />Worth remembering before it slips away.</p>
      </div>
    </div>
  </section>


  <section class="ledger-wrap" id="ledger-wrap" aria-labelledby="ledger" data-guide="Why?" data-next="#how">
    <div class="k-sectionhead">
      <h2 id="ledger">The forgetting,<br />in figures.</h2>
      <p>What goes unused in the US alone.<br />Sourced, not guessed.</p>
    </div>
    <dl class="ledger">
      <div>
        <dt>Unused gift-card value Americans lose out on each year</dt>
        <dd><b class="mono">$23B</b><span>Capital One Shopping, 2026</span></dd>
      </div>
      <div>
        <dt>American adults holding unused gift cards</dt>
        <dd><b class="mono">43%</b><span>Capital One Shopping, 2026</span></dd>
      </div>
      <div>
        <dt>Average unused total per person holding cards</dt>
        <dd><b class="mono">$244</b><span>Capital One Shopping, 2026</span></dd>
      </div>
      <div>
        <dt>People who have held a gift card for at least a year</dt>
        <dd><b class="mono">71%</b><span>Capital One Shopping, 2026</span></dd>
      </div>
    </dl>
  </section>

  <section class="k-how" id="how" aria-labelledby="how-h" data-guide="How?" data-next="#features">
    <div class="k-sectionhead">
      <h2 id="how-h">Less remembering.<br />More enjoying.</h2>
      <p>Small acts of organisation.<br />A little more room in your head.</p>
    </div>
    <ol class="steps">
      <li>
        <span class="k-step-no"><span class="mono">01</span> Bring it home</span>
        <h3>Start with a photo, or just say it.</h3>
        <p>Snap your card, speak the store, amount and expiry, send it through WhatsApp, or type it. You check the details before filing.</p>
      </li>
      <li>
        <span class="k-step-no"><span class="mono">02</span> Make room</span>
        <h3>Give every gift a place.</h3>
        <p>Everyday treats in one drawer. Birthday gifts in another. Memories can stay just that.</p>
      </li>
      <li>
        <span class="k-step-no"><span class="mono">03</span> Keep the thought</span>
        <h3>Ask what to enjoy next.</h3>
        <p>See what is on your shelf and get an email nudge for dates you have confirmed.</p>
      </li>
    </ol>
  </section>
  <section class="k-features" id="features" aria-labelledby="features-h" data-guide="What?" data-next="#close-wrap">
    <div class="k-sectionhead">
      <h2 id="features-h">Everything a drawer<br />should do for you.</h2>
      <p>The whole cabinet, in one look.<br />No upsells hiding in the back.</p>
    </div>
    <ul class="k-feature-grid">
      <li>
        <svg class="ic" aria-hidden="true"><use href="#i-camera" /></svg>
        <h3>Snap it, say it, or type it</h3>
        <p>A photo or a few spoken words give you the retailer, amount and expiry to check. Never the number or PIN. Typing works just as well.</p>
      </li>
      <li>
        <svg class="ic" aria-hidden="true"><use href="#i-archive" /></svg>
        <h3>Drawers you can seal</h3>
        <p>Sort cards into drawers. Put a password on one and it can also hold the full number and PIN, out of sight until you need them.</p>
      </li>
      <li>
        <svg class="ic" aria-hidden="true"><use href="#i-receipt" /></svg>
        <h3>Spend, and say so</h3>
        <p>"I spent 12" or "remaining is 18", confirmed before it lands and undoable after. Every balance change is kept on record.</p>
      </li>
      <li>
        <svg class="ic" aria-hidden="true"><use href="#i-bell" /></svg>
        <h3>A nudge before it expires</h3>
        <p>Pick how far ahead you want to hear about an expiry and an email arrives then. Only for dates you've confirmed.</p>
      </li>
      <li>
        <svg class="ic" aria-hidden="true"><use href="#i-message" /></svg>
        <h3>Ask in plain words</h3>
        <p>"What expires first?" or "How much do I have?" Answers name the cards they came from. Link WhatsApp to file a card from chat.</p>
      </li>
      <li>
        <svg class="ic" aria-hidden="true"><use href="#i-gift" /></svg>
        <h3>Keep the ones that matter</h3>
        <p>Mark a card as a memory and it stays, even at zero. Hide amounts with one tap when someone's looking over your shoulder.</p>
      </li>
    </ul>
  </section>
  <section class="k-closing" id="close-wrap" aria-labelledby="close" data-guide="Now." data-next="#k-hero">
    <div>
      <h2 id="close">A gift is meant to be enjoyed.</h2>
      <p>Not rediscovered three birthdays later.</p>
    </div>
    <a class="btn btn--primary btn--large" href="/signup">Make a little room</a>
  </section>
    </div>
</Base>
)}
{signedIn && (
<AppShell title="Gift Cabinet · Your shelf" active="home">
    <div class="flow">
    <div class="screen-head dash-head">
      <div>
        <p class="eyebrow">Your cabinet.</p>
        <h1>What's on your shelf.</h1>
        <p class="actions">
          <a class="btn btn--primary" href="/file">File a card</a>
          <a class="btn" href="/cabinet">Open the cabinet</a>
        </p>
      </div>
      <MotionFigure scene="home" />
    </div>
    <AskPanel />
    <section class="panel" aria-labelledby="stats-title">
      <h2 id="stats-title">On your shelf</h2>
      <div class="stats" aria-label="Shelf totals">
        <div>
          <b data-amount>{formatTotals(totals)}</b>
          <span>Total on file</span>
        </div>
        <div class="due">
          <b data-amount>{formatTotals(dues)}</b>
          <span>Due soon</span>
        </div>
        <div>
          <b>{cardCount}</b>
          <span>Cards filed</span>
        </div>
      </div>
      {expiring.length > 0 && (
        <p class="ribbon" role="status">
          <svg class="ic ic--sm" aria-hidden="true"><use href="#i-clock" /></svg>
          Expiring soon:{" "}
          {expiring.map((c, i) => (
            <span>
              {i > 0 && " · "}
              <a href={`/cards/${c.id}`}>{c.retailer}</a> <span class="mono" data-amount>{formatMoney(c.balance_cents, c.currency)}</span>
            </span>
          ))}
        </p>
      )}
      {spendNext && (
        <p class="spend-next" role="status">
          <svg class="ic ic--sm" aria-hidden="true"><use href="#i-clock" /></svg>
          Spend next: <a href={`/cards/${spendNext.id}`}>{spendNext.retailer}</a>{" "}
          <span class="mono" data-amount>{formatMoney(spendNext.balance_cents, spendNext.currency)}</span>
          {" · "}
          {spendNext.expiry ? `expires ${fd(spendNext.expiry)}` : "biggest balance, no expiry"}
        </p>
      )}
    </section>
    <section class="panel" aria-labelledby="activity">
      <h2 id="activity">Recent activity</h2>
      {activity.length > 0 ? (
        <>
          <p class="note">Most recently touched first.</p>
          <ul class="activity">
            {activity.map((card) => (
              <li>
                <a class="activity-row" href={`/cards/${card.id}`}>
                  <StoreMark retailer={card.retailer} />
                  <span class="activity-name">
                    <b class="truncate">{card.retailer}</b>
                    <span class="sub">Touched {fd(dayOf(card.updated_at))}</span>
                  </span>
                  <span class="activity-meta">
                    <span class="mono" data-amount>{formatMoney(card.balance_cents, card.currency)}</span>
                    <StatePill state={card.state} />
                  </span>
                </a>
              </li>
            ))}
          </ul>
          <p class="actions">
            <a class="btn" href="/cabinet">Open the cabinet</a>
            <a class="btn btn--primary" href="/file">File a card</a>
          </p>
        </>
      ) : (
        <>
          <p class="note">Nothing filed yet. Your first card starts the shelf.</p>
          <p class="actions">
            <a class="btn btn--primary" href="/file">File a card</a>
          </p>
        </>
      )}
    </section>
    </div>
</AppShell>
)}

<script>
  const btn = document.getElementById("open-drawer");
  const detail = document.getElementById("drawer-detail");
  const hint = document.getElementById("drawer-hint");
  if (btn && detail && hint) {
    detail.hidden = true;
    btn.setAttribute("aria-expanded", "false");
    hint.textContent = "Pull to see what's inside";
    btn.addEventListener("click", () => {
      detail.hidden = !detail.hidden;
      btn.setAttribute("aria-expanded", String(!detail.hidden));
      hint.textContent = detail.hidden ? "Pull to see what's inside" : "Your illustrated drawer is open";
    });
  }

  const guide = document.getElementById("k-guide");
  const guideLabel = document.getElementById("k-guide-label");
  const stops = [...document.querySelectorAll<HTMLElement>("section[data-guide]")];
  if (guide && guideLabel && stops.length > 0) {
    const reduce = matchMedia("(prefers-reduced-motion: reduce)");
    let current: HTMLElement | null = null;
    const page = document.getElementById("k-page");
    const place = (stop: HTMLElement): void => {
      if (!page || stop.id === "k-hero") {
        guide.style.removeProperty("--y");
        return;
      }
      const heading = stop.querySelector("h2") ?? stop;
      const y = heading.getBoundingClientRect().top - page.getBoundingClientRect().top - 56;
      guide.style.setProperty("--y", `${Math.max(0, Math.round(y))}px`);
    };
    const show = (stop: HTMLElement): void => {
      if (stop === current) return;
      const backwards = current ? stops.indexOf(stop) < stops.indexOf(current) : false;
      current = stop;
      const label = stop.dataset.guide ?? "";
      guide.classList.toggle("is-floating", stop.id !== "k-hero");
      place(stop);
      guide.classList.toggle("is-back", backwards);
      guide.dataset.next = stop.dataset.next ?? "";
      guide.setAttribute("aria-label", stop.id === "close-wrap" ? "Back to the top" : "Scroll to the next part");
      guideLabel.classList.remove("is-flipping");
      void guideLabel.offsetWidth;
      guideLabel.textContent = label;
      guideLabel.classList.add("is-flipping");
    };
    const watcher = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) if (entry.isIntersecting) show(entry.target as HTMLElement);
      },
      { rootMargin: "-45% 0px -45% 0px" },
    );
    for (const stop of stops) watcher.observe(stop);
    show(stops[0]);
    addEventListener("resize", () => current && place(current), { passive: true });
    guide.addEventListener("click", () => {
      const next = guide.dataset.next ? document.querySelector(guide.dataset.next) : null;
      next?.scrollIntoView({ behavior: reduce.matches ? "auto" : "smooth", block: "start" });
    });
  }
</script>

<style>
  .k-hero {
    display: grid;
    grid-template-columns: 1.03fr 1fr;
    align-items: center;
    gap: var(--space-2xl);
    padding-block: var(--space-md) 60px;
  }
  .k-eyebrow {
    font-size: var(--text-xs);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    font-weight: 600;
    margin: 0;
  }
  .k-intro h1 {
    font-size: clamp(48px, 5.3vw, 76px);
    letter-spacing: -0.055em;
    line-height: 1.04;
    text-wrap: balance;
    overflow-wrap: break-word;
    min-width: 0;
    margin: 25px 0 26px;
    max-width: 650px;
  }
  .k-intro h1::after { display: none; }
  .k-intro h1 em { font-style: normal; color: var(--color-pine); }
  .k-sub { font-size: var(--text-lg); color: var(--color-muted); max-width: 400px; }
  .k-textlink { font-size: var(--text-sm); border-bottom: 1px solid var(--color-ink); padding: 4px 0; }
  .k-fine { margin-top: var(--space-md); font-size: var(--text-xs); color: var(--color-muted); }
  .k-guide {
    display: inline-flex; align-items: center; gap: var(--space-xs);
    min-height: 44px; padding: 0 var(--space-sm) 0 var(--space-xs);
    border: var(--rule-hair) solid var(--color-rule); border-radius: var(--radius-pill);
    background: var(--color-paper); color: var(--color-ink-2); cursor: pointer;
    font: 600 var(--text-sm)/1 var(--font-body);
    box-shadow: inset 0 1px 0 var(--color-lime-soft);
    transition: box-shadow var(--dur-micro) var(--ease-out), background var(--dur-micro) var(--ease-out);
  }
  .k-guide:hover { background: var(--color-paper-2); box-shadow: var(--shadow-card); }
  .k-guide-emoji { font-size: 22px; line-height: 1; display: inline-block; animation: k-pulse 1.6s var(--ease-in-out) infinite; }
  .k-guide-label { display: inline-block; min-width: 3.2em; }
  .k-guide-label:empty { display: none; }
  .k-guide-label.is-flipping { animation: k-flip var(--dur-short) var(--ease-out); }
  .k-guide.is-back .k-guide-label.is-flipping { animation-name: k-flip-back; }
  .k-page { position: relative; }
  .k-guide.is-floating {
    position: absolute; left: 0; top: 0; z-index: var(--z-raised);
    transform: translateY(var(--y, 0px));
    transition: transform 600ms var(--ease-out), box-shadow var(--dur-micro) var(--ease-out), background var(--dur-micro) var(--ease-out);
    color: var(--color-ink); box-shadow: var(--shadow-card), inset 0 1px 0 var(--color-lime-soft);
    animation: rise var(--dur-short) var(--ease-out);
  }
  .k-guide.is-floating .k-guide-emoji { animation: none; }
  .k-guide.is-floating::after { content: "↓"; color: var(--color-lime-deep); font-weight: 700; }
  .k-guide.is-floating[data-next="#k-hero"]::after { content: "↑"; }
  @keyframes k-pulse { 0%, 100% { transform: scale(1); } 50% { transform: scale(1.14) rotate(-6deg); } }
  @keyframes k-flip { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: none; } }
  @keyframes k-flip-back { from { opacity: 0; transform: translateY(-8px); } to { opacity: 1; transform: none; } }
  @media (prefers-reduced-motion: reduce) {
    .k-guide-emoji, .k-guide-label.is-flipping, .k-guide.is-floating { animation: none; }
    .k-guide.is-floating { transition: none; }
  }
  @media (max-width: 48rem) {
    .k-guide.is-floating { min-height: 40px; font-size: var(--text-xs); }
    .k-guide.is-floating .k-guide-emoji { font-size: 18px; }
  }
  .k-scene { position: relative; padding: 24px 18px 24px 32px; min-width: 0; }
  .k-cabinet {
    background: var(--color-forest);
    padding: 18px 18px 25px;
    border: 1px solid var(--color-forest-deep);
    border-radius: 10px 10px 3px 3px;
    box-shadow: 12px 20px 0 var(--color-cabinet-shadow);
    position: relative;
    transform: rotate(-2deg);
  }
  .k-cabinet::before, .k-cabinet::after {
    content: ""; position: absolute; bottom: -18px;
    background: var(--color-forest); width: 23px; height: 18px;
  }
  .k-cabinet::before { left: 25px; }
  .k-cabinet::after { right: 25px; }
  .k-cabtop {
    display: flex; justify-content: space-between;
    color: var(--color-paper); padding: 5px 5px 18px;
    font-size: 11px; letter-spacing: 0.08em; text-transform: uppercase;
  }
  .k-cards { height: 147px; position: relative; margin: 0 7px -2px; }
  .k-gift {
    position: absolute; width: 65%; height: 140px;
    padding: 18px 21px;
    border: 1px solid var(--color-rule);
    border-radius: var(--radius-md);
    color: var(--color-ink);
  }
  .k-gift:nth-child(1) { transform: rotate(-9deg); left: 5px; top: 5px; background: var(--color-card-sage); }
  .k-gift:nth-child(2) { left: 30%; top: 0; transform: rotate(7deg); background: var(--color-card-sand); }
  .k-gift:nth-child(3) { left: 16%; top: 35px; background: var(--color-card-cream); }
  .k-gift strong { display: block; font-size: 15px; font-weight: 600; }
  .k-balance { display: block; font-family: var(--font-display); font-size: 32px; margin-top: 8px; }
  .k-small { display: block; font-size: var(--text-xs); margin-top: 6px; }
  .k-drawer {
    position: relative;
    background: var(--color-drawer);
    border: 1px solid var(--color-forest-deep);
    border-radius: 3px;
    box-shadow: inset 0 2px 0 var(--color-glint);
    color: var(--color-paper);
    text-align: center;
    padding: var(--space-md);
    margin-bottom: var(--space-sm);
  }
  button.k-drawer { width: 100%; display: block; cursor: pointer; font: inherit; }
  .k-sealed { margin-bottom: 0; }
  .k-drawer-label { font-size: 11px; letter-spacing: 0.12em; text-transform: uppercase; }
  .k-handle {
    display: block; width: 66px; height: 13px; margin: 13px auto 6px;
    border: 3px solid var(--color-brass); border-top-width: 5px;
    border-radius: 3px;
  }
  .k-drawer small { font-size: 10px; }
  #drawer-detail {
    display: block;
    background: var(--color-card-cream); color: var(--color-ink);
    padding: var(--space-sm); font-size: var(--text-xs);
    border-radius: var(--radius-sm); margin-top: 10px;
  }
  #drawer-detail[hidden] { display: none; }
  .k-note {
    position: relative; width: 76%; margin: -5px -4px 0 auto;
    background: var(--color-paper); padding: 17px 20px;
    border: 1px solid var(--color-rule);
    box-shadow: var(--shadow-card);
    transform: rotate(3deg);
  }
  .k-note-eyebrow { font-size: 9px; color: var(--color-clay); margin: 0; }
  .k-note p { font-size: 14px; margin: 6px 0 0; }
  .ledger-wrap { padding: 60px 0 68px; border-top: var(--rule-hair) solid var(--color-rule); }
  .ledger { margin: 0; }
  .ledger > div {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: var(--space-2xs) var(--space-lg);
    align-items: baseline;
    padding-block: var(--space-xs);
    border-top: var(--rule-hair) solid var(--color-rule);
  }
  .ledger > div:last-child { border-bottom: var(--rule-hair) solid var(--color-rule); }
  .ledger dt { margin: 0; color: var(--color-ink-2); max-width: 52ch; font-size: var(--text-md); }
  .ledger dd { margin: 0; display: flex; align-items: baseline; gap: var(--space-sm); white-space: nowrap; }
  .ledger dd b { font-size: var(--text-xl); font-weight: 700; color: var(--color-ink); }
  .ledger dd span { font-size: var(--text-xs); color: var(--color-muted); }
  .k-how { padding: 68px 0; }
