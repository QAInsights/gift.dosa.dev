---
import { env } from "cloudflare:workers";
import "../styles/cabinet.css";
import CabinetStudio from "../components/CabinetStudio.astro";
import DrawerManage from "../components/DrawerManage.astro";
import ErrorBlock from "../components/ErrorBlock.astro";
import TrayCard from "../components/TrayCard.astro";
import AppShell from "../layouts/AppShell.astro";
import { readSessionCookie } from "../lib/auth";
import { dashboard, listCabinet, todayYmd, type PublicCard } from "../lib/cards";
import { drawersWithCounts, toPublicDrawer } from "../lib/drawers";
import { formatDate, formatMoney, formatTotals, plural } from "../lib/format";
import { sessionContext } from "../lib/otp";
import { DEFAULT_PREFS, getPrefs, type Prefs } from "../lib/prefs";

const ctx = env.DB ? await sessionContext(env.DB, readSessionCookie(Astro.request.headers.get("cookie"))) : null;
if (!ctx) return Astro.redirect("/signin");

const params = Astro.url.searchParams;
const query = {
  q: params.get("q") ?? undefined,
  drawer: params.get("drawer") ?? undefined,
  state: params.get("state") ?? undefined,
  memories: params.get("memories") === "1",
  sort: params.get("sort") ?? undefined,
};
const listMode = params.get("view") === "list" || !!(query.q || query.state || query.memories || query.sort);
const today = todayYmd();

function href(patch: Record<string, string | undefined>): string {
  const next = new URLSearchParams(Astro.url.searchParams);
  for (const [key, value] of Object.entries(patch)) {
    if (value === undefined || value === "") next.delete(key);
    else next.set(key, value);
  }
  const search = next.toString();
  return search ? `/cabinet?${search}` : "/cabinet";
}

let dash: Awaited<ReturnType<typeof dashboard>> = {
  totals: {},
  cardCount: 0,
  dues: {},
  dueCount: 0,
  expiring: [],
  sealedCount: 0,
  sampleCount: 0,
  spendNext: null,
};
let shelf: Awaited<ReturnType<typeof listCabinet>> = { cards: [], sealedCount: 0 };
let drawers: Awaited<ReturnType<typeof drawersWithCounts>> = [];
let prefs: Prefs = { ...DEFAULT_PREFS };
let loadError = false;
try {
  if (!env.DB) throw new Error("no database");
  [dash, shelf, drawers, prefs] = await Promise.all([
    dashboard(env.DB, ctx.user.id, ctx.unlocked, today),
    listCabinet(env.DB, ctx.user.id, ctx.unlocked, listMode ? query : { ...query, drawer: undefined }, today),
    drawersWithCounts(env.DB, ctx.user.id, ctx.unlocked),
    getPrefs(env.DB, ctx.user.id).catch(() => ({ ...DEFAULT_PREFS })),
  ]);
} catch {
  loadError = true;
}
const fd = (ymd: string): string => formatDate(ymd, prefs.dateFormat);
const count2 = (n: number): string => String(n).padStart(2, "0");
const selected = drawers.find((d) => d.id === query.drawer);
const managed = selected ? toPublicDrawer(selected, ctx.unlocked, selected.cardCount, selected.subtotals) : null;
const personalCount = dash.cardCount - drawers.reduce((sum, d) => sum + d.cardCount, 0);
const allActive = !query.drawer && !query.memories;
const openKey = query.drawer === "personal" || drawers.some((d) => d.id === query.drawer) ? (query.drawer as string) : "personal";

const publics = drawers.map((d) => toPublicDrawer(d, ctx.unlocked, d.cardCount, d.subtotals));
const byDrawer = new Map<string, PublicCard[]>();
for (const card of shelf.cards) {
  if (!card.drawer_id) continue;
  const group = byDrawer.get(card.drawer_id) ?? [];
  group.push(card);
  byDrawer.set(card.drawer_id, group);
}
const personalCards = shelf.cards.filter((c) => !c.drawer_id);
const sealedDrawers = drawers.filter((d) => d.lock_hash && !ctx.unlocked.includes(d.id));
const listTitle = query.memories ? "Memories" : query.drawer === "personal" ? "Personal" : (selected?.name ?? "Every card on file");
const listLocked = !!selected && !!selected.lock_hash && !ctx.unlocked.includes(selected.id);
const nudge = dash.expiring[0] ?? null;
---

<AppShell title={query.memories ? "Gift Cabinet · Memories" : "Gift Cabinet · The cabinet"} active="cabinet">
 <div class="flow--cabinet atelier">
  <section class="intro">
    <div>
      <span class="eyebrow">A place for the good things.</span>
      <h1>Make yourself at home.</h1>
      <p>Real materials. Little rituals. Your gifts, within reach.</p>
    </div>
    <div class="tabs" role="group" aria-label="Cabinet view">
      <a href="/cabinet" aria-current={!listMode ? "true" : undefined}>Furniture</a>
      <a href="/cabinet?view=list" aria-current={listMode ? "true" : undefined}>Simple list</a>
    </div>
  </section>
  {
    loadError ? (
      <ErrorBlock title="The cabinet did not load.">Check the connection, then reload. Filed cards stay filed.</ErrorBlock>
    ) : (
      <>
        {dash.sampleCount > 0 && (
          <div class="panel banner" role="status">
            <div>
              <b>You're browsing {plural(dash.sampleCount, "sample card", "sample cards")}.</b>
              <span>Click around, open one, see how it feels. Your drawers stay either way.</span>
            </div>
            <form data-action="clear-samples" data-count={plural(dash.sampleCount, "sample card", "sample cards")}>
              <button class="btn btn--small" type="submit">Clear the samples</button>
            </form>
          </div>
        )}
        <dialog class="drawer-dialog" id="drawer-dialog" aria-labelledby="drawer-dialog-title">
          <div class="drawer-dialog-head">
            <h2 id="drawer-dialog-title">
              <span data-dialog-emoji aria-hidden="true">🎁</span>
              <span data-dialog-name>Drawer</span>
            </h2>
            <button class="icon-btn" type="button" data-close-dialog aria-label="Close drawer settings">
              <svg class="ic" aria-hidden="true"><use href="#i-x" /></svg>
            </button>
          </div>
          {publics.map((d) => <DrawerManage drawer={d} />)}
        </dialog>
        <div class="layout">
          <div class="workspace">
            {!listMode ? (
              <section class="stage" id="furniture-view" aria-label="Interactive gift-card cabinet">
                <div class="stage-top">
                  <span class="material-label" id="material-label">NO. 01 / AMERICAN WALNUT</span>
                  <button id="close-all" type="button">Close all drawers</button>
                </div>
                <div class="floor" aria-hidden="true"></div>
                <div class="ground-shadow" aria-hidden="true"></div>
                <div class="cab-wrap">
                  <div class="cabinet" id="cabinet" data-skin="walnut">
                    <div class="badge-plate" aria-hidden="true">GIFT CABINET</div>
                    <div class={`slot${openKey === "personal" ? " is-open" : ""}`} id="slot-personal">
                      <div class="drawer-cavity" aria-hidden="true"></div>
                      <div class="interior" id="tray-personal" hidden={openKey !== "personal"}>
                        {personalCards.length > 0 ? (
                          <>
                            <div class="cards">
                              {personalCards.map((card, i) => (
                                <TrayCard card={card} index={i} dateFormat={prefs.dateFormat} />
                              ))}
                            </div>
                            <span class="felt-caption">Soft lining. A little room to keep things.</span>
                          </>
                        ) : (
                          <div class="empty-interior">
                            <p>
                              A little room for loose cards.<br />
                              <a class="tray-file" href="/file">File a card here</a>
                            </p>
                          </div>
                        )}
                      </div>
                      <button
                        class="front"
                        type="button"
                        data-drawer="personal"
                        aria-expanded={openKey === "personal"}
                        aria-controls="tray-personal"
                      >
                        <span class="label-frame">
                          <span class="label-paper">Personal <span class="count">/ {count2(personalCards.length)}</span></span>
                        </span>
                        <span class="handle" aria-hidden="true"></span>
                      </button>
                    </div>
                    {publics.map((d) => {
                      const cards = byDrawer.get(d.id) ?? [];
                      const sealed = d.locked && !d.unlocked;
                      const isOpen = openKey === d.id && !sealed;
                      return sealed ? (
                        <div class="slot" id={`slot-${d.id}`}>
                          <div class="drawer-cavity" aria-hidden="true"></div>
                          <button
                            class="front"
                            type="button"
                            data-manage={d.id}
                            data-focus="seal"
                            aria-haspopup="dialog"
                            aria-label={`Open ${d.name}`}
                          >
                            <span class="label-frame">
                              <span class="label-paper">
                                <svg aria-hidden="true"><use href="#i-lock" /></svg>{d.name} / sealed
                              </span>
                            </span>
                            <span class="handle" aria-hidden="true"></span>
                          </button>
                        </div>
                      ) : (
                        <div class={`slot${isOpen ? " is-open" : ""}`} id={`slot-${d.id}`}>
                          <div class="drawer-cavity" aria-hidden="true"></div>
                          <div class="interior" id={`tray-${d.id}`} hidden={!isOpen}>
                            {cards.length > 0 ? (
                              <>
                                <div class="cards">
                                  {cards.map((card, i) => (
                                    <TrayCard card={card} index={i} dateFormat={prefs.dateFormat} />
                                  ))}
                                </div>
                                <span class="felt-caption">Soft lining. A little room to keep things.</span>
                              </>
                            ) : (
                              <div class="empty-interior">
                                <p>
                                  A little room for the next occasion.<br />
                                  <a class="tray-file" href="/file">File a card here</a>
                                </p>
                              </div>
                            )}
                            <button class="tray-settings" type="button" data-manage={d.id} data-focus="rename">
                              Drawer settings
                            </button>
                          </div>
                          <button
                            class="front"
                            type="button"
                            data-drawer={d.id}
                            aria-expanded={isOpen}
                            aria-controls={`tray-${d.id}`}
                          >
                            <span class="label-frame">
                              <span class="label-paper">{d.name} <span class="count">/ {count2(d.cardCount)}</span></span>
                            </span>
                            <span class="handle" aria-hidden="true"></span>
                          </button>
                        </div>
                      );
                    })}
                    <div class="legs" aria-hidden="true"><span class="leg"></span><span class="leg"></span></div>
                  </div>
                </div>
                <p class="stage-hint">Pull a handle to open or close. Choose a card to take a closer look.</p>
              </section>
            ) : (
              <>
                <form class="toolbar" method="get" action="/cabinet" role="search">
                  <div class="field">
                    <label for="q">
                      <svg class="ic ic--sm" aria-hidden="true"><use href="#i-search" /></svg>Search your cards
                    </label>
                    <input class="input" id="q" name="q" type="search" autocomplete="off" value={query.q ?? ""} placeholder="Bookshop, Mart, Cinema" />
                  </div>
                  <div class="field">
                    <label for="state">State</label>
                    <select class="input" id="state" name="state">
                      <option value="">All states</option>
                      <option value="filed" selected={query.state === "filed"}>Filed</option>
                      <option value="due" selected={query.state === "due"}>Due soon</option>
                      <option value="spent" selected={query.state === "spent"}>Spent</option>
                    </select>
                  </div>
                  <div class="field">
                    <label for="sort">Sort</label>
                    <select class="input" id="sort" name="sort">
                      <option value="">Recently filed</option>
                      <option value="expiry" selected={query.sort === "expiry"}>Expiring first</option>
                      <option value="balance" selected={query.sort === "balance"}>Highest balance</option>
                      <option value="retailer" selected={query.sort === "retailer"}>Retailer A–Z</option>
                    </select>
                  </div>
                  <input type="hidden" name="view" value="list" />
                  {query.memories && <input type="hidden" name="memories" value="1" />}
                  {query.drawer && <input type="hidden" name="drawer" value={query.drawer} />}
                  <p class="toolbar-actions">
                    <button class="btn btn--primary" type="submit">Search</button>
                  </p>
                </form>
                <nav class="rail" aria-label="Drawers">
                  <a class={allActive ? "chip is-active" : "chip"} href={href({ drawer: undefined, memories: undefined })} aria-current={allActive ? "true" : undefined}>
                    All cards <span class="mono">{dash.cardCount}</span>
                  </a>
                  <a
                    class={query.drawer === "personal" && !query.memories ? "chip is-active" : "chip"}
                    href={href({ drawer: "personal", memories: undefined })}
                    aria-current={query.drawer === "personal" && !query.memories ? "true" : undefined}
                  >
                    Personal <span class="mono">{personalCount}</span>
                  </a>
                  {drawers.map((d) => {
                    const active = query.drawer === d.id && !query.memories;
                    const sealedChip = !!d.lock_hash && !ctx.unlocked.includes(d.id);
                    const pub = publics.find((p) => p.id === d.id);
                    return (
                      <span class="rail-item">
                        <a class={active ? "chip is-active" : "chip"} href={href({ drawer: d.id, memories: undefined })} aria-current={active ? "true" : undefined}>
                          {sealedChip && (
                            <svg class="ic ic--sm" aria-hidden="true"><use href="#i-lock" /></svg>
                          )}
                          {d.name} <span class="mono">{d.cardCount}</span>
                        </a>
                        <button
                          class="drawer-emoji"
                          type="button"
                          data-manage={d.id}
                          data-focus="emoji"
                          aria-label={`Change emoji for ${d.name}`}
                          title="Change emoji"
                        >
                          {pub?.emoji ?? "🎁"}
                        </button>
                      </span>
                    );
                  })}
                  <a
                    class={query.memories && !query.drawer ? "chip is-active" : "chip"}
                    href={href({ drawer: undefined, memories: "1" })}
                    aria-current={query.memories && !query.drawer ? "true" : undefined}
                  >
                    Memories
                  </a>
                </nav>
                {managed && (
                  <p class="actions">
                    <button class="btn" type="button" data-manage={managed.id} data-focus="rename">
                      <svg class="ic ic--sm" aria-hidden="true"><use href="#i-settings" /></svg>Manage {managed.name}
                    </button>
                  </p>
                )}
                <details class="newdrawer">
                  <summary>
                    <span>New drawer</span>
                    <span class="mono">{plural(drawers.length, "drawer", "drawers")} so far</span>
                  </summary>
                  <form data-action="create">
                    <div class="form-grid">
                      <div class="field">
                        <label for="dname">Drawer name</label>
                        <input class="input" id="dname" name="name" type="text" autocomplete="off" placeholder="Travel, Tech" maxlength="60" />
                      </div>
                      <div class="field">
                        <label for="dseal">
                          Lock <span>(optional)</span>
                        </label>
                        <input class="input" id="dseal" name="password" type="password" autocomplete="off" placeholder="Leave blank to stay open" />
                      </div>
                    </div>
                    <p>
                      <button class="btn btn--primary" type="submit">
                        <svg class="ic ic--sm" aria-hidden="true"><use href="#i-plus" /></svg>Create the drawer
                      </button>
                    </p>
                    <p class="help" aria-live="polite" />
                  </form>
                </details>
                <p class="note" role="status">
                  Showing {plural(shelf.cards.length, "card", "cards")}. <a href="/cabinet?view=list">Clear the filter</a>
                </p>
                <section class="list-view" id="list-view" aria-label="Cards as a simple list">
                  <span class="eyebrow">Quiet, simple, everything on hand.</span>
                  {listLocked && selected ? (
                    <>
                      <h2>{listTitle}</h2>
                      <p class="note">Sealed with a password.</p>
                      <button class="quiet-btn" type="button" data-manage={selected.id} data-focus="seal">
                        <svg aria-hidden="true"><use href="#i-lock" /></svg>{selected.name} is sealed
                      </button>
                    </>
                  ) : shelf.cards.length > 0 ? (
                    <>
                      <h2>{listTitle}</h2>
                      {shelf.cards.map((card) => (
                        <a class="list-card" href={`/cards/${card.id}`}>
                          <span>
                            <b>{card.retailer}</b>
                            <small>
                              {card.sample ? "Sample · " : ""}Gift card ·{" "}
                              {card.expiry ? `expires ${fd(card.expiry)}` : "no expiry"}
                            </small>
                          </span>
                          <strong data-amount>{formatMoney(card.balance_cents, card.currency)}</strong>
                        </a>
                      ))}
                      {shelf.sealedCount > 0 && (
                        <>
                          <p class="note">
                            {plural(shelf.sealedCount, "card rests", "cards rest")} in sealed drawers, not included.
                          </p>
                          {sealedDrawers.map((d) => (
                            <button class="quiet-btn" type="button" data-manage={d.id} data-focus="seal">
                              <svg aria-hidden="true"><use href="#i-lock" /></svg>{d.name} is sealed
                            </button>
                          ))}
                        </>
                      )}
                    </>
                  ) : query.memories ? (
                    <>
                      <h2>No memories yet.</h2>
                      <p class="note">Cards you keep rest here, even after the balance is gone.</p>
                    </>
                  ) : dash.cardCount === 0 ? (
                    <>
                      <h2>No cards filed yet.</h2>
                      <p class="note">File the first card so balances stop hiding in drawers.</p>
                      <p>
                        <a class="quiet-btn" href="/file">
                          <svg aria-hidden="true"><use href="#i-plus" /></svg>File a card
                        </a>
                      </p>
                    </>
                  ) : shelf.sealedCount > 0 && !query.q && !query.state ? (
                    <>
                      <h2>Everything is sealed.</h2>
                      <p class="note">Open a drawer to see your cards.</p>
                      <p>
                        {sealedDrawers.map((d) => (
                          <button class="quiet-btn" type="button" data-manage={d.id} data-focus="seal">
                            <svg aria-hidden="true"><use href="#i-lock" /></svg>{d.name} is sealed
                          </button>
                        ))}
                      </p>
                    </>
                  ) : (
                    <>
                      <h2>Nothing matches that filter.</h2>
                      <p class="note">Try fewer letters, or file the card if it is new.</p>
                      <p>
                        <a class="quiet-btn" href="/cabinet?view=list">Clear the filter</a>
                      </p>
                    </>
                  )}
                </section>
              </>
            )}
            <div class="summary">
              <div>
                <b data-amount>{formatTotals(dash.totals)}</b><small>on your shelf</small>
              </div>
              <span class="muted">
                {plural(dash.cardCount, "card", "cards")} on file
                {dash.sealedCount > 0 && (<><br />Sealed contents excluded</>)}
              </span>
            </div>
            <div class="below">
              <div>
                <span class="smallcaps">One useful little nudge</span>
                {nudge ? (
                  <>
                    <h2>A {nudge.retailer} worth remembering.</h2>
                    <p>
                      Your <span data-amount>{formatMoney(nudge.balance_cents, nudge.currency)}</span>{" "}
                      {nudge.retailer} card expires {fd(nudge.expiry)}. A quiet reminder belongs here, not a
                      flashing warning on the furniture.
                    </p>
                  </>
                ) : dash.spendNext ? (
                  <>
                    <h2>Spend {dash.spendNext.retailer} next.</h2>
                    <p>
                      <span data-amount>{formatMoney(dash.spendNext.balance_cents, dash.spendNext.currency)}</span>{" "}
                      on file
                      {dash.spendNext.expiry ? `, expiring ${fd(dash.spendNext.expiry)}` : ", biggest balance, no expiry"}.
                      Ready when you are.
                    </p>
                  </>
                ) : (
                  <>
                    <h2>Nothing asking for attention.</h2>
                    <p>No card expires soon. The cabinet stays quiet until one does.</p>
                  </>
                )}
              </div>
              <div>
                <span class="smallcaps">Thoughtful by design</span>
                <h2>More object. Less dashboard.</h2>
                <p>
                  Label holders, real-looking handles, lined trays, and a place to put things. The numbers
                  stay clear. The cabinet gets the personality.
                </p>
              </div>
            </div>
          </div>
          <CabinetStudio />
        </div>
        <div class="live" id="announcement" role="status" aria-live="polite"></div>
      </>
    )
  }
 </div>
</AppShell>

<script>
  const routes: Record<string, { method: string; url: (id: string) => string }> = {
    create: { method: "POST", url: () => "/api/drawers" },
    rename: { method: "PATCH", url: (id) => `/api/drawers/${id}` },
    emoji: { method: "PATCH", url: (id) => `/api/drawers/${id}` },
    seal: { method: "POST", url: (id) => `/api/drawers/${id}/lock` },
    "change-seal": { method: "POST", url: (id) => `/api/drawers/${id}/lock` },
    unseal: { method: "DELETE", url: (id) => `/api/drawers/${id}/lock` },
    unlock: { method: "POST", url: (id) => `/api/drawers/${id}/unlock` },
    relock: { method: "POST", url: (id) => `/api/drawers/${id}/relock` },
    delete: { method: "DELETE", url: (id) => `/api/drawers/${id}` },
    "clear-samples": { method: "DELETE", url: () => "/api/samples" },
  };

  for (const form of document.querySelectorAll<HTMLFormElement>("form[data-action]")) {
    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      const action = form.getAttribute("data-action") as keyof typeof routes;
      const id = form.getAttribute("data-id") ?? "";
      const help = form.querySelector<HTMLElement>("[aria-live]");
      if (help) {
        help.textContent = "";
        help.className = "help";
      }
      if (action === "delete") {
        const name = form.getAttribute("data-name") ?? "this drawer";
        if (!confirm(`Discard ${name}? Its cards move to Personal.`)) return;
      }
      if (action === "clear-samples") {
        const count = form.getAttribute("data-count") ?? "sample cards";
        if (!confirm(`Remove the ${count}? Your own cards stay put.`)) return;
      }
      const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
      if (button) button.disabled = true;
      try {
        const fields = new FormData(form);
        const body: Record<string, string> = {};
        for (const [key, value] of fields) body[key] = String(value);
        const submitter = (event as SubmitEvent).submitter as HTMLButtonElement | null;
        if (submitter?.name) body[submitter.name] = submitter.value;
        const route = routes[action];
        const res = await fetch(route.url(id), {
          method: route.method,
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(body),
        });
        const data = (await res.json().catch(() => ({}))) as { error?: string; drawer?: { emoji?: string } };
        if (!res.ok) throw new Error(data.error || "Something went wrong.");
        if (action === "unlock") {
          location.href = `/cabinet?drawer=${id}`;
        } else if (action === "emoji") {
          const newEmoji = data.drawer?.emoji ?? body.emoji ?? "";
          if (newEmoji) {
            for (const btn of document.querySelectorAll<HTMLElement>(`.drawer-emoji[data-manage="${id}"]`)) {
              btn.textContent = newEmoji;
            }
            form.closest("[data-manage-panel]")?.setAttribute("data-emoji", newEmoji);
            const titleEmoji = document.querySelector("[data-dialog-emoji]");
            if (titleEmoji) titleEmoji.textContent = newEmoji;
            for (const opt of form.querySelectorAll<HTMLButtonElement>(".emoji-opt")) {
              opt.setAttribute("aria-pressed", String(opt.value === newEmoji));
            }
            if (help) help.textContent = "Emoji saved.";
          }
        } else {
          location.reload();
        }
      } catch (error) {
        if (help) {
          help.textContent = error instanceof Error ? error.message : "Something went wrong.";
          help.className = "help help--error";
        }
      } finally {
        if (button) button.disabled = false;
      }
    });
  }

  for (const input of document.querySelectorAll<HTMLInputElement>('form[data-action="rename"] input[name="name"]')) {
    input.addEventListener("blur", () => {
      const form = input.closest("form");
      const panel = input.closest("[data-manage-panel]");
      const current = panel?.getAttribute("data-name") ?? "";
      if (form && input.value.trim() && input.value.trim() !== current) form.requestSubmit();
    });
  }

  function play(kind: string): void {
    document.dispatchEvent(new CustomEvent("cabinet:play", { detail: kind }));
  }
  let announceTimer = 0;
  function announce(message: string): void {
    const live = document.getElementById("announcement");
    if (!live) return;
    live.textContent = message;
    clearTimeout(announceTimer);
    announceTimer = window.setTimeout(() => {
      live.textContent = "";
    }, 3200);
  }

  function setTray(slot: Element, open: boolean): void {
    const tray = slot.querySelector(".interior");
    if (tray instanceof HTMLElement) tray.hidden = !open;
  }
  function closeSlot(slot: Element): void {
    slot.classList.remove("is-open");
    slot.querySelector(".front")?.setAttribute("aria-expanded", "false");
    setTray(slot, false);
  }
  function openSlot(slot: Element): void {
    for (const other of document.querySelectorAll(".slot.is-open")) {
      if (other !== slot) closeSlot(other);
    }
    slot.classList.add("is-open");
    slot.querySelector(".front")?.setAttribute("aria-expanded", "true");
    setTray(slot, true);
  }
  for (const btn of document.querySelectorAll<HTMLButtonElement>(".front[data-drawer]")) {
    btn.addEventListener("click", () => {
      const slot = btn.closest(".slot");
      if (!slot) return;
      if (slot.classList.contains("is-open")) {
        closeSlot(slot);
        play("close");
      } else {
        openSlot(slot);
        play("open");
      }
    });
  }
  document.getElementById("close-all")?.addEventListener("click", () => {
    const hadOpen = document.querySelector(".slot.is-open");
    for (const slot of document.querySelectorAll(".slot.is-open")) closeSlot(slot);
    if (hadOpen) play("close");
    announce("All drawers closed.");
  });

  const drawerDialog = document.getElementById("drawer-dialog") as HTMLDialogElement | null;
  let dialogOpener: HTMLElement | null = null;
  function openDrawerDialog(id: string, focus: string, opener: HTMLElement): void {
    if (!drawerDialog) return;
    dialogOpener = opener;
    let activePanel: HTMLElement | null = null;
    for (const panel of drawerDialog.querySelectorAll<HTMLElement>("[data-manage-panel]")) {
      const active = panel.getAttribute("data-manage-panel") === id;
      panel.hidden = !active;
      if (active) activePanel = panel;
    }
    if (!activePanel) return;
    const emojiOnly = focus === "emoji";
    activePanel.classList.toggle("is-emoji-only", emojiOnly);
    const emojiEl = drawerDialog.querySelector("[data-dialog-emoji]");
    const nameEl = drawerDialog.querySelector("[data-dialog-name]");
    if (emojiEl) emojiEl.textContent = activePanel.getAttribute("data-emoji") ?? "🎁";
    if (nameEl) nameEl.textContent = activePanel.getAttribute("data-name") ?? "Drawer";
    drawerDialog.showModal();
    activePanel.querySelector<HTMLElement>(`[data-focus="${focus}"]`)?.focus();
  }
  for (const btn of document.querySelectorAll<HTMLButtonElement>("[data-manage]")) {
    btn.addEventListener("click", () => {
      const id = btn.getAttribute("data-manage") ?? "";
      openDrawerDialog(id, btn.getAttribute("data-focus") ?? "rename", btn);
    });
  }
  drawerDialog?.addEventListener("click", (event) => {
    if (event.target === drawerDialog) drawerDialog.close();
  });
  drawerDialog?.addEventListener("close", () => dialogOpener?.focus());
  for (const btn of document.querySelectorAll<HTMLButtonElement>("[data-close-dialog]")) {
    btn.addEventListener("click", () => drawerDialog?.close());
  }
  document.addEventListener("keydown", (event) => {
    if (event.key !== "Escape" || document.querySelector("dialog[open]")) return;
    const open = document.querySelector(".slot.is-open");
    if (!open) return;
    closeSlot(open);
    open.querySelector<HTMLElement>(".front")?.focus();
    play("close");
  });

  for (const el of document.querySelectorAll('select[name="state"], select[name="sort"]')) {
    if (!(el instanceof HTMLSelectElement)) continue;
    el.addEventListener("change", () => el.form?.requestSubmit());
  }
</script>
