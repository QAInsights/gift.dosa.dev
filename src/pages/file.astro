---
import { env } from "cloudflare:workers";
import AppShell from "../layouts/AppShell.astro";
import { aiConfigFromEnv } from "../lib/ai";
import { readSessionCookie } from "../lib/auth";
import { listDrawers } from "../lib/db";
import { sessionContext } from "../lib/otp";
import { REMINDER_OPTIONS } from "../lib/reminders";
import MotionFigure from "../components/illustrations/MotionFigure.astro";
import { CURRENCIES, DEFAULT_PREFS, getPrefs, type Prefs } from "../lib/prefs";

const ctx = env.DB ? await sessionContext(env.DB, readSessionCookie(Astro.request.headers.get("cookie"))) : null;
if (!ctx) return Astro.redirect("/signin");

let drawers: { id: string; name: string }[] = [];
let prefs: Prefs = { ...DEFAULT_PREFS };
try {
  if (env.DB) {
    drawers = (await listDrawers(env.DB, ctx.user.id)).results;
    prefs = await getPrefs(env.DB, ctx.user.id).catch(() => ({ ...DEFAULT_PREFS }));
  }
} catch {
  drawers = [];
}
const photoOn = aiConfigFromEnv(env as unknown as Record<string, string | undefined>) !== null;
---

<AppShell title="Gift Cabinet · File a card" active="file">
 <div class="flow">
  <div class="screen-head">
    <div>
      <h1>File a card</h1>
      <p>Snap the card and check what we read, or just write down what it says.</p>
    </div>
  </div>
  <p class="error" id="file-error" role="alert" tabindex="-1" hidden></p>
  <div class="panel snap">
    <form id="snap-form" class="snap-form">
      <div class="snap-main">
      <fieldset disabled={!photoOn}>
        <div class="field">
          <label for="f-photo">
            <svg class="ic ic--sm" aria-hidden="true"><use href="#i-camera" /></svg>Snap the card
          </label>
          <input class="input" id="f-photo" name="photo" type="file" accept="image/*" capture="environment" />
        </div>
        <div class="snap-preview" id="snap-preview" hidden>
          <img id="snap-img" alt="Your card photo" />
          <span class="scanline" aria-hidden="true"></span>
        </div>
        <p>
          <button class="btn btn--primary" type="submit">
            <svg class="ic ic--sm" aria-hidden="true"><use href="#i-camera" /></svg>Read the card
          </button>
        </p>
      </fieldset>
      <p class="help" id="snap-note" aria-live="polite">
        {photoOn
          ? "We read the retailer, amount, and expiry only. Never the number or PIN. Check everything before you file it."
          : "Photo reading isn't switched on here yet. Type the card in the form below instead."}
      </p>
      </div>
      <div class="snap-motion">
        <MotionFigure scene="file" />
      </div>
    </form>
  </div>
  <div class="panel voice" id="voice-panel">
    <div class="field">
      <span class="field-label" id="voice-label"><span aria-hidden="true">🎤</span> Speak the details</span>
      <p>
        <button class="btn btn--primary" type="button" id="voice-btn" aria-describedby="voice-note"><span aria-hidden="true">🎤</span> Start recording</button>
      </p>
    </div>
    <p class="help" id="voice-note">Speak the store, amount, and expiry. Do not say the card number or PIN.</p>
    <div id="voice-live" hidden>
      <p role="status"><span class="rec-dot" aria-hidden="true"></span>Listening<span id="voice-interim"></span></p>
      <p>
        <button class="btn btn--small" type="button" id="voice-stop">Stop</button>
        <button class="btn btn--small" type="button" id="voice-cancel">Cancel</button>
      </p>
    </div>
    <div id="voice-heard" hidden>
      <p>Heard: <q id="voice-transcript"></q></p>
      <p class="help" id="voice-review" aria-live="polite"></p>
    </div>
  </div>
  <div class="panel" id="file-panel">
    <form id="file-form">
      <div class="form-grid">
        <div class="field">
          <label for="f-retailer">Retailer</label>
          <input class="input" id="f-retailer" name="retailer" type="text" autocomplete="off" maxlength="80" required />
        </div>
        <div class="field">
          <label for="f-amount">Amount</label>
          <input class="input" id="f-amount" name="balance" type="text" inputmode="decimal" placeholder="25.00" required />
        </div>
        <div class="field">
          <label for="f-currency">Currency</label>
          <select class="input" id="f-currency" name="currency" aria-describedby="f-currency-note">
            {CURRENCIES.map((c) => (
              <option value={c.code} selected={c.code === prefs.currency}>{c.label}</option>
            ))}
          </select>
          <p class="help" id="f-currency-note">Starts from your profile default. Change it for this card only.</p>
        </div>
        <div class="field">
          <label for="f-exp">Expires</label>
          <input class="input" id="f-exp" name="expiry" type="date" />
        </div>
        <div class="field">
          <label for="f-reminder">Remind me</label>
          <select class="input" id="f-reminder" name="reminder">
            {REMINDER_OPTIONS.map((o) => (
              <option value={o.days === null ? "" : String(o.days)} selected={o.days === 7}>{o.label}</option>
            ))}
          </select>
        </div>
        <div class="field">
          <label for="f-drawer">Drawer</label>
          <select class="input" id="f-drawer" name="drawer_id">
            <option value="">Personal</option>
            {drawers.map((d) => (
              <option value={d.id}>{d.name}</option>
            ))}
          </select>
        </div>
      </div>
      <details class="optdetails">
        <summary>More details <span>(optional)</span></summary>
        <div class="form-grid">
          <div class="field">
            <label for="f-nick">Nickname</label>
            <input class="input" id="f-nick" name="nickname" type="text" maxlength="80" placeholder="Birthday from Ana" />
          </div>
          <div class="field">
            <label for="f-last4">Last 4</label>
            <input class="input" id="f-last4" name="last4" type="text" inputmode="numeric" maxlength="4" placeholder="4402" />
          </div>
          <div class="field">
            <label for="f-occasion">Occasion</label>
            <input class="input" id="f-occasion" name="occasion" type="text" maxlength="40" placeholder="Birthday" />
          </div>
          <div class="field">
            <label for="f-tags">Tags <span>(comma-separated)</span></label>
            <input class="input" id="f-tags" name="tags" type="text" placeholder="food, weekly" />
          </div>
        </div>
        <div class="field">
          <label for="f-notes">Notes</label>
          <textarea class="input" id="f-notes" name="notes" rows="3" maxlength="2000"></textarea>
        </div>
      </details>
      <p>
        <button class="btn btn--primary" type="submit">
          <svg class="ic ic--sm" aria-hidden="true"><use href="#i-stamp" /></svg>File it
        </button>
      </p>
    </form>
  </div>
  <div class="panel" id="filed-panel" hidden>
    <p>
      <span class="pill pill--filed stamp" id="filed-stamp">
        <svg class="ic ic--sm" aria-hidden="true"><use href="#i-check-c" /></svg>Filed.
      </span>
    </p>
    <dl class="facts" id="filed-facts"></dl>
    <p class="actions">
      <button class="btn" type="button" id="file-another">File another</button>
      <a class="btn btn--primary" href="/cabinet">Back to the cabinet</a>
    </p>
  </div>
 </div>
</AppShell>

<script>
  import { fitWithin } from "../lib/image";

  const form = document.getElementById("file-form") as HTMLFormElement;
  const errorBox = document.getElementById("file-error") as HTMLParagraphElement;
  const filePanel = document.getElementById("file-panel") as HTMLDivElement;
  const filedPanel = document.getElementById("filed-panel") as HTMLDivElement;
  const facts = document.getElementById("filed-facts") as HTMLElement;

  function burst(): void {
    if (matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    const canvas = document.createElement("canvas");
    canvas.setAttribute("aria-hidden", "true");
    canvas.style.cssText = "position:fixed;inset:0;pointer-events:none;z-index:500";
    document.body.appendChild(canvas);
    const ctx2d = canvas.getContext("2d");
    if (!ctx2d) return;
    canvas.width = window.innerWidth;
    canvas.height = window.innerHeight;
    const colors = ["oklch(72% 0.15 88)", "oklch(44% 0.16 8)", "oklch(48% 0.09 195)", "oklch(90% 0.07 88)"];
    const parts = Array.from({ length: 90 }, (_, i) => ({
      x: canvas.width / 2 + (Math.random() - 0.5) * 120,
      y: canvas.height * 0.35,
      vx: (Math.random() - 0.5) * 9,
      vy: Math.random() * -7 - 2,
      s: Math.random() * 7 + 4,
      c: colors[i % 4],
    }));
    const start = performance.now();
    function tick(now: number): void {
      const age = now - start;
      ctx2d?.clearRect(0, 0, canvas.width, canvas.height);
      for (const p of parts) {
        p.x += p.vx;
        p.y += p.vy;
        p.vy += 0.35;
        if (!ctx2d) continue;
        ctx2d.globalAlpha = Math.max(0, 1 - age / 1400);
        ctx2d.fillStyle = p.c;
        ctx2d.fillRect(p.x, p.y, p.s, p.s * 0.62);
      }
      if (age < 1500) requestAnimationFrame(tick);
      else canvas.remove();
    }
    requestAnimationFrame(tick);
  }

  form.addEventListener("submit", async (event) => {
    event.preventDefault();
    errorBox.hidden = true;
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    if (button) button.disabled = true;
    try {
      const fields = new FormData(form);
      const body: Record<string, string> = {};
      for (const [key, value] of fields) body[key] = String(value);
      const res = await fetch("/api/cards", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(body),
      });
      const data = (await res.json().catch(() => ({}))) as { error?: string };
      if (!res.ok) throw new Error(data.error || "Something went wrong.");
      const drawerEl = document.getElementById("f-drawer");
      const drawerText =
        drawerEl instanceof HTMLSelectElement
          ? (drawerEl.options[drawerEl.selectedIndex]?.text ?? "Personal")
          : "Personal";
      const REMINDER_LABELS: Record<string, string> = {
        "": "Off",
        "0": "On the day it expires",
        "3": "3 days before",
        "7": "A week before",
        "14": "2 weeks before",
        "30": "A month before",
      };
      const currency = body.currency || "USD";
      let amount: string;
      try {
        amount = `${new Intl.NumberFormat("en-US", { style: "currency", currency }).format(Number(body.balance))} ${currency}`;
      } catch {
        amount = `${body.balance} ${currency}`;
      }
      const rows: [string, string][] = [
        ["Retailer", body.retailer],
        ["Amount", amount],
        ["Expires", body.expiry || "No expiry"],
        ["Drawer", drawerText],
        ["Remind me", REMINDER_LABELS[body.reminder ?? ""] ?? "Off"],
      ];
      facts.replaceChildren();
      for (const [term, detail] of rows) {
        const wrap = document.createElement("div");
        const dt = document.createElement("dt");
        dt.textContent = term;
        const dd = document.createElement("dd");
        dd.textContent = detail;
        wrap.appendChild(dt);
        wrap.appendChild(dd);
        facts.appendChild(wrap);
      }
      filePanel.hidden = true;
      filedPanel.hidden = false;
      burst();
    } catch (error) {
      const message =
        error instanceof TypeError
          ? "Couldn't reach the cabinet. Check your connection and try again. Your entries are still here."
          : error instanceof Error
            ? error.message
            : "Something went wrong.";
      errorBox.textContent = message;
      errorBox.hidden = false;
      const field = /balance|amount/i.test(message)
        ? document.getElementById("f-amount")
        : /retailer/i.test(message)
          ? document.getElementById("f-retailer")
          : /expir|date/i.test(message)
            ? document.getElementById("f-exp")
            : null;
      const smooth = !matchMedia("(prefers-reduced-motion: reduce)").matches;
      if (field instanceof HTMLElement) field.focus({ preventScroll: true });
      errorBox.scrollIntoView({ behavior: smooth ? "smooth" : "auto", block: "nearest" });
    } finally {
      if (button) button.disabled = false;
    }
  });

  const snapForm = document.getElementById("snap-form") as HTMLFormElement;
  const snapNote = document.getElementById("snap-note") as HTMLParagraphElement;
  const snapPreview = document.getElementById("snap-preview") as HTMLDivElement;
  const snapImg = document.getElementById("snap-img") as HTMLImageElement;
  const photoInput = document.getElementById("f-photo") as HTMLInputElement;
  const SNAP_DEFAULT = snapNote.textContent ?? "";
  let snapUrl: string | null = null;

  function showSnapPreview(): void {
    const file = photoInput.files?.[0];
    if (!file) return;
    if (snapUrl) URL.revokeObjectURL(snapUrl);
    snapUrl = URL.createObjectURL(file);
    snapImg.src = snapUrl;
    snapPreview.hidden = false;
  }

  photoInput.addEventListener("change", showSnapPreview);

  async function preparePhoto(file: File): Promise<Blob> {
    try {
      const bitmap = await createImageBitmap(file);
      const { width, height } = fitWithin(bitmap.width, bitmap.height, 1600);
      if (width === bitmap.width && height === bitmap.height && file.size < 1_000_000) {
        bitmap.close();
        return file;
      }
      const canvas = document.createElement("canvas");
      canvas.width = width;
      canvas.height = height;
      const g = canvas.getContext("2d");
      if (!g) {
        bitmap.close();
        return file;
      }
      g.drawImage(bitmap, 0, 0, width, height);
      bitmap.close();
      const blob = await new Promise<Blob | null>((resolve) => canvas.toBlob(resolve, "image/jpeg", 0.85));
      return blob ?? file;
    } catch {
      return file;
    }
  }

  snapForm.addEventListener("submit", async (event) => {
    event.preventDefault();
    if (!photoInput.files?.[0]) {
      snapNote.textContent = "Pick a photo first.";
      snapNote.className = "help help--error";
      photoInput.focus();
      return;
    }
    const button = snapForm.querySelector<HTMLButtonElement>('button[type="submit"]');
    const buttonText = button?.textContent ?? "";
    if (button) {
      button.disabled = true;
      button.textContent = "Reading…";
    }
    photoInput.disabled = true;
    showSnapPreview();
    snapPreview.classList.add("is-reading");
    snapNote.textContent = "Reading the photo…";
    snapNote.className = "help";
    try {
      const photo = await preparePhoto(photoInput.files[0]);
      const body = new FormData();
      body.append("photo", photo, "card.jpg");
      const res = await fetch("/api/extract", { method: "POST", body });
      const data = (await res.json().catch(() => ({}))) as {
        error?: string;
        fields?: { retailer?: string; balance?: string; expiry?: string };
      };
      if (!res.ok) throw new Error(data.error || "The photo could not be read. Type the card instead.");
      const fields = data.fields ?? {};
      const set = (id: string, value?: string) => {
        const el = document.getElementById(id);
        if (el instanceof HTMLInputElement && value) el.value = value;
      };
      set("f-retailer", fields.retailer);
      set("f-amount", fields.balance);
      set("f-exp", fields.expiry);
      snapNote.textContent = "Filled from your photo. Check it, then File it.";
      document.getElementById("f-retailer")?.focus();
    } catch (error) {
      snapNote.textContent =
        error instanceof TypeError
          ? "The reading didn't finish. Check the connection and try again, or type the card instead."
          : error instanceof Error
            ? error.message
            : "The photo could not be read. Type the card instead.";
      snapNote.className = "help help--error";
    } finally {
      snapPreview.classList.remove("is-reading");
      photoInput.disabled = false;
      if (button) {
        button.disabled = false;
        button.textContent = buttonText;
      }
    }
  });

  document.getElementById("file-another")?.addEventListener("click", () => {
    form.reset();
    snapForm.reset();
    if (snapUrl) URL.revokeObjectURL(snapUrl);
    snapUrl = null;
    snapImg.removeAttribute("src");
    snapPreview.hidden = true;
    snapNote.textContent = SNAP_DEFAULT;
    snapNote.className = "help";
    filedPanel.hidden = true;
    filePanel.hidden = false;
  });
</script>

<script>
  type VoiceDraft = {
    retailer: string | null;
    amount: string | null;
    currency: string | null;
    currencyConfident: boolean;
    expiry: string | null;
    occasion: string | null;
    notes: string | null;
    drawerId: string | null;
    drawerName: string | null;
    transcript: string;
    needsReview: string[];
  };
  const voiceBtn = document.getElementById("voice-btn") as HTMLButtonElement | null;
  const voiceNote = document.getElementById("voice-note") as HTMLParagraphElement | null;
  const voiceLive = document.getElementById("voice-live") as HTMLDivElement | null;
  const voiceInterim = document.getElementById("voice-interim") as HTMLSpanElement | null;
  const voiceHeard = document.getElementById("voice-heard") as HTMLDivElement | null;
  const voiceTranscript = document.getElementById("voice-transcript") as HTMLElement | null;
  const voiceReview = document.getElementById("voice-review") as HTMLParagraphElement | null;
  const w = window as unknown as { SpeechRecognition?: any; webkitSpeechRecognition?: any };
  const VoiceRec = w.SpeechRecognition ?? w.webkitSpeechRecognition ?? null;
  if (!VoiceRec && voiceBtn) {
    voiceBtn.disabled = true;
    if (voiceNote) voiceNote.textContent = "Voice typing isn't supported in this browser. Type the card below instead.";
  }

  let touchedCurrency = false;
  let touchedDrawer = false;
  document.getElementById("f-currency")?.addEventListener("change", () => { touchedCurrency = true; });
  document.getElementById("f-drawer")?.addEventListener("change", () => { touchedDrawer = true; });

  function fillEmpty(id: string, value: string | null): boolean {
    const el = document.getElementById(id);
    if (el instanceof HTMLInputElement && value && !el.value) {
      el.value = value;
      return true;
    }
    if (el instanceof HTMLTextAreaElement && value && !el.value) {
      el.value = value;
      return true;
    }
    return false;
  }

  function flagForReview(id: string): void {
    document.getElementById(id)?.closest(".field")?.classList.add("field--review");
  }

  function applyDraft(draft: VoiceDraft): void {
    fillEmpty("f-retailer", draft.retailer);
    fillEmpty("f-amount", draft.amount);
    fillEmpty("f-exp", draft.expiry);
    const extras = fillEmpty("f-occasion", draft.occasion) || fillEmpty("f-notes", draft.notes);
    if (extras) document.querySelector(".optdetails")?.setAttribute("open", "");
    const currencyEl = document.getElementById("f-currency");
    const currencyNote = document.getElementById("f-currency-note");
    if (draft.currency && currencyEl instanceof HTMLSelectElement && !touchedCurrency) {
      const known = [...currencyEl.options].some((o) => o.value === draft.currency);
      if (known) {
        currencyEl.value = draft.currency;
        if (currencyNote) {
          currencyNote.textContent = draft.currencyConfident
            ? `Voice heard ${draft.currency}.`
            : `Voice proposed ${draft.currency} from your default. Confirm it.`;
        }
      }
    }
    const drawerEl = document.getElementById("f-drawer");
    if (draft.drawerId !== null && drawerEl instanceof HTMLSelectElement && !touchedDrawer) {
      const known = [...drawerEl.options].some((o) => o.value === draft.drawerId);
      if (known) drawerEl.value = draft.drawerId;
    }
    const checks: string[] = [];
    if (draft.needsReview.includes("retailer")) checks.push("add the retailer");
    if (draft.amount && draft.needsReview.includes("amount")) {
      flagForReview("f-amount");
      checks.push("check the amount");
    }
    if (draft.needsReview.includes("currency") && draft.currency) {
      flagForReview("f-currency");
      checks.push(`confirm the currency (proposed ${draft.currency} from your default)`);
    }
    if (draft.needsReview.includes("drawer")) checks.push("pick a drawer");
    if (draft.needsReview.includes("expiry")) {
      flagForReview("f-exp");
      checks.push("fix the expiry");
    }
    if (voiceReview) {
      voiceReview.textContent = checks.length > 0
        ? `Draft ready. ${checks[0].slice(0, 1).toUpperCase()}${checks[0].slice(1)}${checks.slice(1).map((c) => `, ${c}`).join("")} before filing.`
        : "Draft ready. Check it, then File it.";
      voiceReview.className = "help";
    }
    if (voiceTranscript) voiceTranscript.textContent = draft.transcript;
    if (voiceHeard) voiceHeard.hidden = false;
    document.getElementById("f-retailer")?.focus();
  }

  async function extractTranscript(transcript: string): Promise<void> {
    if (voiceReview) {
      voiceReview.textContent = "Reading what you said…";
      voiceReview.className = "help";
    }
    if (voiceHeard) voiceHeard.hidden = false;
    try {
      const now = new Date();
      const today = `${now.getFullYear()}-${String(now.getMonth() + 1).padStart(2, "0")}-${String(now.getDate()).padStart(2, "0")}`;
      const res = await fetch("/api/voice/extract", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          transcript,
          today,
          timeZone: Intl.DateTimeFormat().resolvedOptions().timeZone,
        }),
      });
      const data = (await res.json().catch(() => ({}))) as { error?: string; draft?: VoiceDraft };
      if (!res.ok || !data.draft) throw new Error(data.error || "That didn't come through. Type the card instead.");
      applyDraft(data.draft);
    } catch (error) {
      if (voiceTranscript) voiceTranscript.textContent = transcript;
      if (voiceHeard) voiceHeard.hidden = false;
      if (voiceReview) {
        voiceReview.textContent =
          error instanceof Error ? error.message : "That didn't come through. Type the card instead.";
        voiceReview.className = "help help--error";
      }
    }
  }

  let rec: any = null;
  let recCancelled = false;
  let recFinal = "";

  voiceBtn?.addEventListener("click", () => {
    if (!VoiceRec || !voiceLive) return;
    for (const el of document.querySelectorAll(".field--review")) el.classList.remove("field--review");
    recFinal = "";
    recCancelled = false;
    if (voiceInterim) voiceInterim.textContent = "";
    rec = new VoiceRec();
    rec.lang = navigator.language || "en-US";
    rec.interimResults = true;
    rec.maxAlternatives = 1;
    rec.onresult = (event: any) => {
      let interim = "";
      for (let i = event.resultIndex; i < event.results.length; i++) {
        const text: string = event.results[i][0].transcript;
        if (event.results[i].isFinal) recFinal += text;
        else interim += text;
      }
      if (voiceInterim) voiceInterim.textContent = interim ? ` ${interim}` : "";
    };
    rec.onerror = () => {
      if (voiceLive) voiceLive.hidden = true;
      if (voiceReview) {
        voiceReview.textContent = "The microphone didn't cooperate. Check permission and try again, or type the card.";
        voiceReview.className = "help help--error";
      }
      if (voiceHeard) voiceHeard.hidden = false;
      rec = null;
    };
    rec.onend = () => {
      if (voiceLive) voiceLive.hidden = true;
      const said = recFinal.trim();
      rec = null;
      if (!recCancelled && said) void extractTranscript(said);
    };
    try {
      rec.start();
      voiceLive.hidden = false;
    } catch {
      if (voiceLive) voiceLive.hidden = true;
    }
  });

  document.getElementById("voice-stop")?.addEventListener("click", () => {
    try { rec?.stop(); } catch { /* already ended */ }
  });
  document.getElementById("voice-cancel")?.addEventListener("click", () => {
    recCancelled = true;
    try { rec?.abort(); } catch { /* already ended */ }
    if (voiceLive) voiceLive.hidden = true;
  });
  document.getElementById("file-another")?.addEventListener("click", () => {
    for (const el of document.querySelectorAll(".field--review")) el.classList.remove("field--review");
    if (voiceHeard) voiceHeard.hidden = true;
    if (voiceTranscript) voiceTranscript.textContent = "";
    if (voiceReview) voiceReview.textContent = "";
  });
</script>

<style>
  .field--review .input { border-color: var(--color-lime-deep); box-shadow: 0 0 0 3px var(--color-lime-soft); }
  .rec-dot {
    display: inline-block; width: 0.6em; height: 0.6em; border-radius: 50%;
    background: var(--color-oxblood); margin-right: var(--space-xs);
  }
  @media (prefers-reduced-motion: no-preference) {
    .rec-dot { animation: rec-pulse 1.2s ease-in-out infinite; }
    @keyframes rec-pulse { 50% { opacity: 0.35; } }
