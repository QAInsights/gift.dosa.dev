---
import { env } from "cloudflare:workers";
import AppShell from "../layouts/AppShell.astro";
import { readSessionCookie } from "../lib/auth";
import { findWhatsappLinkByUser } from "../lib/db";
import { formatDate, formatMoney } from "../lib/format";
import { sessionUser } from "../lib/otp";
import { CURRENCIES, DATE_FORMAT_OPTIONS, DEFAULT_PREFS, getPrefs, REGIONS, type Prefs } from "../lib/prefs";

const user = env.DB ? await sessionUser(env.DB, readSessionCookie(Astro.request.headers.get("cookie"))) : null;
if (!user) return Astro.redirect("/signin");

let prefs: Prefs = { ...DEFAULT_PREFS };
if (env.DB) {
  try {
    prefs = await getPrefs(env.DB, user.id);
  } catch {
    prefs = { ...DEFAULT_PREFS };
  }
}
const sample = `Sample: 12.00 shows as ${formatMoney(1200, prefs.currency)} · ${formatDate("2027-05-03", prefs.dateFormat)}.`;
const waLink = env.DB ? await findWhatsappLinkByUser(env.DB, user.id).catch(() => null) : null;
const waNumber = (env as unknown as Record<string, string | undefined>).WHATSAPP_DISPLAY_NUMBER?.trim() ?? "";
---

<AppShell title="Gift Cabinet · Settings" active="account">
 <div class="flow">
  <div class="screen-head">
    <div>
      <h1>Settings</h1>
      <p>Signed in as {user.email}.</p>
    </div>
  </div>
  <section class="panel" aria-labelledby="profile-title">
    <h2 id="profile-title">Profile</h2>
    <form id="profile-form">
      <div class="field">
        <label for="p-name">Display name</label>
        <input class="input" id="p-name" name="name" type="text" autocomplete="name" maxlength="80" value={user.name ?? ""} placeholder="Your name" />
      </div>
      <div class="form-grid">
        <div class="field">
          <label for="p-region">
            <svg class="ic ic--sm" aria-hidden="true"><use href="#i-globe" /></svg>Region
          </label>
          <select class="input" id="p-region" name="region">
            {REGIONS.map((r) => (
              <option value={r.code} selected={r.code === prefs.region}>{r.label}</option>
            ))}
          </select>
        </div>
        <div class="field">
          <label for="p-currency">
            <svg class="ic ic--sm" aria-hidden="true"><use href="#i-wallet" /></svg>Default currency
          </label>
          <select class="input" id="p-currency" name="currency">
            {CURRENCIES.map((c) => (
              <option value={c.code} selected={c.code === prefs.currency}>{c.label}</option>
            ))}
          </select>
        </div>
        <div class="field">
          <label for="p-datefmt">
            <svg class="ic ic--sm" aria-hidden="true"><use href="#i-cal" /></svg>Date format
          </label>
          <select class="input" id="p-datefmt" name="date_format">
            {DATE_FORMAT_OPTIONS.map((o) => (
              <option value={o.code} selected={o.code === prefs.dateFormat}>{o.label}</option>
            ))}
          </select>
        </div>
      </div>
      <p class="note" id="prefs-preview" aria-live="polite">{sample}</p>
      <p class="help" id="profile-help" aria-live="polite">Changes save automatically.</p>
    </form>
  </section>
  <section class="panel" aria-labelledby="wa-title" data-wa-number={waNumber}>
    <h2 id="wa-title">WhatsApp</h2>
    {waLink?.verified_at ? (
      <>
        <p>Linked to +{waLink.phone}. Send a card photo to file it straight from chat.</p>
        <form id="wa-unlink">
          <p>
            <button class="btn" type="submit">Unlink this number</button>
          </p>
          <p class="help" id="wa-help" aria-live="polite" />
        </form>
      </>
    ) : (
      <form id="wa-link">
        <div class="field">
          <label for="wa-phone">Your WhatsApp number</label>
          <input
            class="input"
            id="wa-phone"
            name="phone"
            type="tel"
            autocomplete="tel"
            inputmode="tel"
            placeholder="15551234567"
            value={waLink?.phone ?? ""}
          />
        </div>
        <p>
          <button class="btn btn--primary" type="submit">Get linking code</button>
        </p>
        <p class="note" id="wa-code" aria-live="polite" hidden />
        <p class="actions" id="wa-actions" hidden>
          <button class="btn btn--small" type="button" id="wa-copy">Copy the message</button>
          <a class="btn btn--small" id="wa-open" href="#" target="_blank" rel="noopener">Open in WhatsApp</a>
        </p>
        <p class="help" id="wa-help" aria-live="polite" />
      </form>
    )}
  </section>
  <section class="panel" aria-label="Account details">
    <dl class="facts">
      <div>
        <dt>Email</dt>
        <dd>{user.email}</dd>
      </div>
      <div id="account-name-row" hidden={!user.name}>
        <dt>Name</dt>
        <dd id="account-name">{user.name ?? ""}</dd>
      </div>
    </dl>
    <form id="signout-form">
      <p>
        <button class="btn" type="submit">Sign out</button>
      </p>
    </form>
  </section>
 </div>
</AppShell>

<script>
  document.getElementById("signout-form")?.addEventListener("submit", async (event) => {
    event.preventDefault();
    await fetch("/api/auth/signout", { method: "POST" });
    location.assign("/");
  });

  const testNumber = document.querySelector("[data-wa-number]")?.getAttribute("data-wa-number") ?? "";
  document.getElementById("wa-link")?.addEventListener("submit", async (event) => {
    event.preventDefault();
    const form = event.target as HTMLFormElement;
    const help = document.getElementById("wa-help");
    const codeEl = document.getElementById("wa-code");
    const phone = new FormData(form).get("phone");
    if (help) {
      help.textContent = "Making your code…";
      help.className = "help";
    }
    try {
      const res = await fetch("/api/whatsapp/link", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ phone }),
      });
      const data = (await res.json().catch(() => ({}))) as { error?: string; link?: { code?: string } };
      if (!res.ok) throw new Error(data.error || "That number did not work.");
      if (codeEl && data.link?.code) {
        const message = `LINK ${data.link.code}`;
        codeEl.hidden = false;
        codeEl.textContent = testNumber ? `Message ${testNumber} on WhatsApp with: ${message}` : `Send this on WhatsApp: ${message}`;
        codeEl.setAttribute("data-message", message);
        document.getElementById("wa-actions")?.removeAttribute("hidden");
        const open = document.getElementById("wa-open") as HTMLAnchorElement | null;
        const digits = testNumber.replace(/\D/g, "");
        if (open) {
          if (digits) {
            open.hidden = false;
            open.href = `https://wa.me/${digits}?text=${encodeURIComponent(message)}`;
          } else {
            open.hidden = true;
          }
        }
      }
      if (help) help.textContent = "Code ready. It stays valid until you link or ask for a new one.";
    } catch (error) {
      if (help) {
        help.textContent = error instanceof Error ? error.message : "That number did not work.";
        help.className = "help help--error";
      }
    }
  });

  document.getElementById("wa-copy")?.addEventListener("click", async () => {
    const help = document.getElementById("wa-help");
    const message = document.getElementById("wa-code")?.getAttribute("data-message") ?? "";
    if (!message) return;
    try {
      await navigator.clipboard.writeText(message);
      if (help) help.textContent = "Copied. Paste it into WhatsApp to link this number.";
    } catch {
      if (help) help.textContent = "Copy didn't work here. Type it from the message above.";
    }
  });

  document.getElementById("wa-unlink")?.addEventListener("submit", async (event) => {
    event.preventDefault();
    await fetch("/api/whatsapp/link", { method: "DELETE" });
    location.reload();
  });

  const profileForm = document.getElementById("profile-form") as HTMLFormElement | null;
  const help = document.getElementById("profile-help");
  const preview = document.getElementById("prefs-preview");
  const regionEl = document.getElementById("p-region") as HTMLSelectElement | null;
  const currencyEl = document.getElementById("p-currency") as HTMLSelectElement | null;
  const dateEl = document.getElementById("p-datefmt") as HTMLSelectElement | null;
  let saving = false;
  let saveQueued = false;

  function sampleText(): string {
    const currency = currencyEl?.value ?? "USD";
    const fmt = dateEl?.value ?? "MDY";
    let money: string;
    try {
      money = new Intl.NumberFormat("en-US", { style: "currency", currency }).format(12);
    } catch {
      money = `12.00 ${currency}`;
    }
    let date: string;
    if (fmt === "ISO") {
      date = "2027-05-03";
    } else {
      date = new Intl.DateTimeFormat(fmt === "DMY" ? "en-GB" : "en-US", {
        month: "short",
        day: "numeric",
        year: "numeric",
        timeZone: "UTC",
      }).format(new Date(Date.UTC(2027, 4, 3)));
    }
    return `Sample: 12.00 shows as ${money} · ${date}.`;
  }

  function syncPreview(): void {
    if (preview) preview.textContent = sampleText();
  }
  regionEl?.addEventListener("change", syncPreview);
  currencyEl?.addEventListener("change", syncPreview);
  dateEl?.addEventListener("change", syncPreview);

  async function saveProfile(): Promise<void> {
    if (!profileForm) return;
    if (saving) {
      saveQueued = true;
      return;
    }
    saving = true;
    const fields = new FormData(profileForm);
    const body: Record<string, string> = {};
    for (const [key, value] of fields) body[key] = String(value);
    if (help) {
      help.textContent = "Saving…";
      help.className = "help";
    }
    try {
      const res = await fetch("/api/profile", {
        method: "PATCH",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(body),
      });
      const data = (await res.json().catch(() => ({}))) as {
        error?: string;
        user?: { name?: string | null };
      };
      if (!res.ok) throw new Error(data.error || "Settings could not be saved.");
      const nameRow = document.getElementById("account-name-row");
      const nameEl = document.getElementById("account-name");
      const savedName = data.user?.name ?? null;
      if (nameRow) nameRow.hidden = !savedName;
      if (nameEl) nameEl.textContent = savedName ?? "";
      if (help) help.textContent = "Saved to your account.";
    } catch (error) {
      if (help) {
        help.textContent = error instanceof Error ? error.message : "Settings could not be saved.";
        help.className = "help help--error";
      }
    } finally {
      saving = false;
      if (saveQueued) {
        saveQueued = false;
        void saveProfile();
      }
    }
  }

  profileForm?.addEventListener("change", () => void saveProfile());
  profileForm?.addEventListener("submit", (event) => event.preventDefault());
</script>
