---
import MotionFigure from "../components/illustrations/MotionFigure.astro";
import Base from "../layouts/Base.astro";

export const prerender = true;
---

<Base title="Gift Cabinet · Not found">
  <section class="hero hero--split" aria-labelledby="h1">
    <div>
      <h1 id="h1">That shelf is empty.</h1>
      <p class="lead">The page you asked for is not on file.</p>
      <p class="actions">
        <a class="btn btn--primary" href="/">Back home</a>
      </p>
    </div>
    <MotionFigure scene="missing" />
  </section>
</Base>
